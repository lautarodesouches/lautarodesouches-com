---
import styles from '../styles/Badge.module.css'

interface Props {
  variant?: 'default' | 'primary' | 'success' | 'tech' | 'outline'
  size?: 'sm' | 'md'
  dot?: boolean
  class?: string
}

const {
  variant = 'default',
  size = 'md',
  dot = false,
  class: className = '',
} = Astro.props

const badgeClasses = [
  styles.badge,
  styles[`badge--${variant}`],
  size === 'sm' ? styles['badge--sm'] : '',
  className,
].filter(Boolean).join(' ')
---

<span class={badgeClasses}>
  {dot && <span class={styles.badge__dot} />}
  <slot />
</span>

