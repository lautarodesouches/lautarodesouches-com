---
import { Menu, X, ArrowUpRight } from 'lucide-astro'
import BrandGlyph from './BrandGlyph.astro'
import styles from '../styles/Header.module.css'

const navLinks = [
  { href: '#soluciones', label: 'Soluciones' },
  { href: '#proyectos', label: 'Proyectos' },
  { href: '#stack', label: 'Stack' },
  { href: '#trayectoria', label: 'Trayectoria' },
  { href: '#contacto', label: 'Contacto' },
]
---

<header class={styles.header} id="main-header">
  <div class={styles.header__pill}>
    <a href="#" class={styles.header__brand} aria-label="Lautaro Desouches">
      <BrandGlyph size={20} />
      <span class={styles.header__name}>Lautaro Desouches</span>
    </a>

    <span class={styles.header__agenda}>
      Agenda: 1 cupo Q2
    </span>

    <nav class={styles.header__nav} aria-label="Navegación principal">
      <ul class={styles['header__nav-list']}>
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class={styles['header__nav-link']}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a href="#contacto" class={styles['header__cta-btn']}>
      <span>Hablemos</span>
      <ArrowUpRight size={14} />
    </a>

    <button
      type="button"
      class={styles['header__mobile-btn']}
      id="pill-menu-toggle"
      aria-label="Abrir navegación"
      aria-expanded="false"
    >
      <span id="pill-icon-open"><Menu size={18} /></span>
      <span id="pill-icon-close" style="display: none;"><X size={18} /></span>
    </button>
  </div>

  <div class={styles['header__mobile-drawer']} id="pill-mobile-drawer">
    {navLinks.map((link) => (
      <a href={link.href} class={styles['header__mobile-link']}>
        {link.label}
      </a>
    ))}
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('pill-menu-toggle')
  const drawer = document.getElementById('pill-mobile-drawer')
  const iconOpen = document.getElementById('pill-icon-open')
  const iconClose = document.getElementById('pill-icon-close')
  const drawerLinks = drawer?.querySelectorAll('a')

  const toggle = () => {
    const isOpen = drawer?.classList.toggle('header__mobile-drawer--open')
    toggleBtn?.setAttribute('aria-expanded', String(isOpen))
    if (iconOpen && iconClose) {
      iconOpen.style.display = isOpen ? 'none' : 'block'
      iconClose.style.display = isOpen ? 'block' : 'none'
    }
  }

  toggleBtn?.addEventListener('click', toggle)

  drawerLinks?.forEach((link) => {
    link.addEventListener('click', () => {
      drawer?.classList.remove('header__mobile-drawer--open')
      toggleBtn?.setAttribute('aria-expanded', 'false')
      if (iconOpen && iconClose) {
        iconOpen.style.display = 'block'
        iconClose.style.display = 'none'
      }
    })
  })
</script>
