---
import styles from '../styles/BrandGlyph.module.css'

interface Props {
  size?: number
  class?: string
}

const { size = 24, class: className = '' } = Astro.props
---

<span class={`${styles['brand-glyph']} ${className}`} style={`width: ${size}px; height: ${size}px;`}>
  <svg
    viewBox="0 0 24 24"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class={styles['brand-glyph__svg']}
    aria-hidden="true"
  >
    <path
      d="M4 12L12 4M12 4L20 12M12 4V20"
      class={styles['brand-glyph__path']}
    />
    <circle cx="12" cy="4" r="2.25" class={styles['brand-glyph__node']} />
  </svg>
</span>
