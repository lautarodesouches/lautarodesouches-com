---
---

<div class="intro-iris" id="intro-iris" aria-hidden="true">
  <svg class="intro-iris-svg" width="100%" height="100%" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice">
    <defs>
      <filter id="iris-feather" x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="3.5"></feGaussianBlur>
      </filter>
      <mask id="iris-mask">
        <rect width="100" height="100" fill="#ffffff"></rect>
        <circle id="iris-mask-circle" cx="50" cy="50" r="0" fill="#000000" filter="url(#iris-feather)"></circle>
      </mask>
    </defs>
    <rect width="100" height="100" fill="#0A0A0A" mask="url(#iris-mask)"></rect>
  </svg>
</div>

<script>
  import { gsap } from 'gsap'

  interface LenisInstance {
    stop: () => void
    start: () => void
  }

  interface WindowWithLenis extends Window {
    __lenis?: LenisInstance
  }

  const curtain = document.getElementById('intro-iris')
  const circle = document.getElementById('iris-mask-circle')

  const getLenis = (): LenisInstance | undefined => {
    return (window as unknown as WindowWithLenis).__lenis
  }

  const skipIntro = () => {
    if (curtain) {
      curtain.style.display = 'none'
      curtain.remove()
    }
    document.body.classList.remove('intro-running')
    getLenis()?.start()
    window.dispatchEvent(
      new CustomEvent('intro:complete', {
        detail: { immediate: true },
      })
    )
  }

  const playIntro = () => {
    if (!curtain || !circle) return

    const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    if (isReducedMotion) {
      skipIntro()
      return
    }

    getLenis()?.stop()
    document.body.classList.add('intro-running')

    gsap.set(circle, { attr: { r: 0 } })
    gsap.set(curtain, { display: 'block', visibility: 'visible', opacity: 1 })

    const tl = gsap.timeline({
      onComplete: () => {
        document.body.classList.remove('intro-running')
        getLenis()?.start()
        curtain.style.display = 'none'
        curtain.remove()
      },
    })

    tl.to(
      circle,
      {
        attr: { r: 98 },
        duration: 1.15,
        ease: 'power2.inOut',
      },
      0
    )

    tl.fromTo(
      '#hero-canvas-scale-wrapper',
      {
        scale: 0.72,
        opacity: 0.6,
      },
      {
        scale: 1,
        opacity: 1,
        duration: 1.2,
        ease: 'power2.out',
        clearProps: 'opacity',
      },
      0
    )

    tl.add(() => {
      window.dispatchEvent(
        new CustomEvent('intro:complete', {
          detail: { marqueeBoost: false },
        })
      )
    }, 0.35)

    tl.to(
      curtain,
      {
        opacity: 0,
        duration: 0.35,
        ease: 'power1.inOut',
      },
      0.85
    )
  }

  const init = () => {
    requestAnimationFrame(playIntro)
  }

  if (document.readyState === 'loading') {
    window.addEventListener('DOMContentLoaded', init)
  } else {
    init()
  }
</script>

<style>
  .intro-iris {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    z-index: 9999;
    background-color: transparent;
    pointer-events: none;
    overflow: hidden;
  }

  .intro-iris-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }

  :global(body.intro-running) {
    overflow: hidden !important;
    touch-action: none !important;
  }
</style>
