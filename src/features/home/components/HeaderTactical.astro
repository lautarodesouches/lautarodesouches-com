---
import { GITHUB_URL, LINKEDIN_URL, EMAIL } from '@/shared/constants/contact'
---

<header
  class="sticky top-0 z-40 w-full border-b border-surface-border bg-surface/90 backdrop-blur-md transition-colors"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
    <div class="flex items-center gap-4">
      <a
        href="/"
        class="group flex items-center gap-2 font-mono text-sm tracking-wider font-semibold text-slate-900 dark:text-white"
      >
        <span class="inline-block w-2.5 h-2.5 bg-signal-emerald animate-pulse"></span>
        <span class="group-hover:text-signal-emerald transition-colors">LAUTARO DESOUCHES</span>
        <span class="hidden sm:inline text-xs text-slate-400 dark:text-zinc-600">// ARQUITECTURA</span>
      </a>

      <div
        class="hidden md:flex items-center gap-2 pl-4 border-l border-surface-border text-xs font-mono text-slate-500 dark:text-zinc-400"
      >
        <span class="inline-block w-2 h-2 rounded-full bg-signal-emerald"></span>
        <span>DISPONIBLE PARA PROYECTOS</span>
        <span class="text-slate-300 dark:text-zinc-700">|</span>
        <span id="header-live-clock" class="text-slate-700 dark:text-zinc-300 tabular-nums">--:--:-- ART</span>
      </div>
    </div>

    <nav class="hidden lg:flex items-center gap-6 font-mono text-xs">
      <a
        href="#about"
        class="text-slate-600 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-white transition-colors"
      >
        <span class="text-signal-emerald">01.</span> PERFIL
      </a>
      <a
        href="#projects"
        class="text-slate-600 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-white transition-colors"
      >
        <span class="text-signal-emerald">02.</span> PROYECTOS
      </a>
      <a
        href="#skills"
        class="text-slate-600 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-white transition-colors"
      >
        <span class="text-signal-emerald">03.</span> STACK
      </a>
      <a
        href="/servicios"
        class="text-slate-600 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-white transition-colors"
      >
        <span class="text-signal-emerald">04.</span> SERVICIOS
      </a>
      <a
        href="#contact"
        class="text-slate-600 dark:text-zinc-400 hover:text-slate-900 dark:hover:text-white transition-colors"
      >
        <span class="text-signal-emerald">05.</span> CONTACTO
      </a>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={`mailto:${EMAIL}?subject=Consulta%20desde%20tu%20Portfolio`}
        class="px-3.5 py-1.5 rounded-none font-mono text-xs font-medium bg-slate-900 text-white dark:bg-white dark:text-black hover:bg-signal-emerald hover:text-black dark:hover:bg-signal-emerald dark:hover:text-black transition-colors flex items-center gap-1.5"
      >
        <span>CONTACTAR</span>
        <span>→</span>
      </a>

      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Perfil de GitHub"
        class="p-2 border border-surface-border text-slate-700 dark:text-zinc-300 hover:border-slate-800 dark:hover:border-zinc-500 transition-colors hidden sm:flex items-center justify-center"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"
          ></path>
        </svg>
      </a>

      <a
        href={LINKEDIN_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Perfil de LinkedIn"
        class="p-2 border border-surface-border text-slate-700 dark:text-zinc-300 hover:border-slate-800 dark:hover:border-zinc-500 transition-colors hidden sm:flex items-center justify-center"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  function updateClock() {
    const clockEl = document.getElementById('header-live-clock')
    if (!clockEl) return
    const now = new Date()
    const options: Intl.DateTimeFormatOptions = {
      timeZone: 'America/Argentina/Buenos_Aires',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false,
    }
    clockEl.textContent = `${new Intl.DateTimeFormat('es-AR', options).format(now)} ART`
  }

  updateClock()
  setInterval(updateClock, 1000)
  document.addEventListener('astro:page-load', updateClock)
</script>
