---
import { portfolioData } from '../data/portfolio.data'
const { skills } = portfolioData
---

<section id="skills" class="py-28 px-6 bg-white dark:bg-black">
  <div class="max-w-6xl mx-auto fade-in-view">
    <div class="space-y-4 mb-16">
      <p class="text-sm font-mono text-brand dark:text-tech uppercase tracking-widest">
        Tecnologías
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
        Stack Tecnológico
      </h2>
    </div>

    <div class="space-y-16">
      <div>
        <h3 class="text-sm font-mono uppercase tracking-widest text-brand dark:text-tech mb-8">
          {skills.core.title}
        </h3>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          {
            skills.core.items.map((group) => (
              <div>
                <p class="text-xs font-mono text-slate-400 dark:text-gray-500 uppercase tracking-wider mb-3">
                  {group.category}
                </p>
                <ul class="flex flex-wrap gap-2">
                  {group.techs.map((tech) => (
                    <li>
                      <span class="px-3 py-1.5 text-sm font-medium rounded-md bg-brand/5 dark:bg-tech/10 text-brand dark:text-tech border border-brand/20 dark:border-tech/30 block">
                        {tech}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>

      <div
        class="grid lg:grid-cols-3 gap-12 pt-8 border-t border-slate-100 dark:border-white/10"
      >
        {
          [skills.secondary, skills.background, skills.tools].map((group) => (
            <div>
              <h3 class="text-sm font-mono uppercase tracking-widest text-slate-400 dark:text-gray-500 mb-4">
                {group.title}
              </h3>
              <ul class="flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <li>
                    <span class="px-3 py-1.5 text-sm font-medium rounded-md bg-slate-50 dark:bg-white/5 text-slate-600 dark:text-gray-400 border border-slate-200 dark:border-white/10 block">
                      {item}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
