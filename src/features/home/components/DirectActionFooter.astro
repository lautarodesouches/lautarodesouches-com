---
import { EMAIL, WHATSAPP_URL, LINKEDIN_URL, GITHUB_URL } from '@/shared/constants/contact'
---

<footer id="contact" class="py-24 px-4 sm:px-6 bg-surface-card border-t border-surface-border">
  <div class="max-w-7xl mx-auto space-y-16">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-surface-border pb-8">
      <div class="space-y-3">
        <div class="flex items-center gap-2 font-mono text-xs text-signal-emerald">
          <span class="inline-block w-2 h-2 bg-signal-emerald"></span>
          <span>SEC // 04 — CONTACTO DIRECTO & PROTOCOLO</span>
        </div>
        <h2 class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-slate-950 dark:text-white">
          ¿Listo para Construir Algo Excepcional?
        </h2>
      </div>

      <div class="font-mono text-xs text-slate-500 dark:text-zinc-400">
        <span>RESPUESTA HABITUAL: &lt; 24 HORAS</span>
      </div>
    </div>

    <div class="grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-7 space-y-6">
        <p class="text-lg text-slate-700 dark:text-zinc-300 leading-relaxed font-sans max-w-2xl">
          Ya sea que busques sumar a tu equipo un desarrollador con criterio de arquitectura sólida, o necesites acelerar el desarrollo de un producto web de alto rendimiento, conversemos sobre requerimientos técnicos y próximos pasos.
        </p>

        <div class="space-y-3 pt-2">
          <span class="font-mono text-xs text-slate-400 dark:text-zinc-500 uppercase tracking-wider block">
            ACCESO RÁPIDO // COPIAR CORREO CON UN CLIC
          </span>

          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            <button
              id="btn-copy-email"
              type="button"
              data-email={EMAIL}
              class="group px-5 py-4 border border-surface-border bg-surface hover:border-signal-emerald transition-all font-mono text-xs sm:text-sm flex items-center justify-between gap-4 text-left w-full sm:w-auto"
            >
              <div class="flex items-center gap-3">
                <span class="w-2 h-2 bg-signal-emerald"></span>
                <span id="copy-email-text" class="text-slate-900 dark:text-white font-semibold">
                  {EMAIL}
                </span>
              </div>
              <span
                id="copy-status-badge"
                class="px-2 py-1 bg-slate-900 text-white dark:bg-white dark:text-black text-xs font-mono group-hover:bg-signal-emerald group-hover:text-black transition-colors"
              >
                COPIAR CORREO
              </span>
            </button>

            <a
              href={`mailto:${EMAIL}?subject=Contacto%20desde%20tu%20Portfolio`}
              class="px-5 py-4 border border-surface-border bg-surface text-slate-700 dark:text-zinc-300 hover:border-slate-800 dark:hover:border-zinc-500 font-mono text-xs sm:text-sm text-center transition-colors"
            >
              ABRIR EN APP DE CORREO ↗
            </a>
          </div>
        </div>
      </div>

      <div class="lg:col-span-5 space-y-4">
        <span class="font-mono text-xs text-slate-400 dark:text-zinc-500 uppercase tracking-wider block">
          CANALES DIRECTOS DE COMUNICACIÓN
        </span>

        <div class="grid gap-3 font-mono text-xs">
          <a
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 border border-surface-border bg-surface hover:border-signal-emerald transition-colors flex items-center justify-between text-slate-900 dark:text-white group"
          >
            <div class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-full bg-signal-emerald"></span>
              <span class="font-semibold">WHATSAPP DIRECTO</span>
            </div>
            <span class="text-slate-400 group-hover:text-signal-emerald transition-colors">
              INICIAR CHAT ↗
            </span>
          </a>

          <a
            href={LINKEDIN_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 border border-surface-border bg-surface hover:border-slate-800 dark:hover:border-zinc-500 transition-colors flex items-center justify-between text-slate-900 dark:text-white group"
          >
            <div class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-full bg-signal-cyan"></span>
              <span class="font-semibold">LINKEDIN // PERFIL PROFESIONAL</span>
            </div>
            <span class="text-slate-400 group-hover:text-slate-900 dark:group-hover:text-white transition-colors">
              CONECTAR ↗
            </span>
          </a>

          <a
            href={GITHUB_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 border border-surface-border bg-surface hover:border-slate-800 dark:hover:border-zinc-500 transition-colors flex items-center justify-between text-slate-900 dark:text-white group"
          >
            <div class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-full bg-slate-400"></span>
              <span class="font-semibold">GITHUB // REPOSITORIOS PÚBLICOS</span>
            </div>
            <span class="text-slate-400 group-hover:text-slate-900 dark:group-hover:text-white transition-colors">
              EXPLORAR CÓDIGO ↗
            </span>
          </a>
        </div>
      </div>
    </div>

    <div class="pt-12 border-t border-surface-border font-mono text-xs text-slate-500 dark:text-zinc-500 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <div class="flex flex-wrap items-center gap-4">
        <span>BUENOS AIRES, ARGENTINA // UTC-3</span>
        <span class="text-slate-300 dark:text-zinc-700 hidden sm:inline">|</span>
        <span class="text-signal-emerald">ESTADO: EN LÍNEA & OPERACIONAL</span>
      </div>

      <div>
        <span>© {new Date().getFullYear()} LAUTARO DESOUCHES · ARQUITECTURA DE SOFTWARE</span>
      </div>
    </div>
  </div>
</footer>

<script>
  function setupCopyButton() {
    const btnCopy = document.getElementById('btn-copy-email')
    const badge = document.getElementById('copy-status-badge')
    if (!btnCopy || !badge) return

    btnCopy.addEventListener('click', async () => {
      const email = btnCopy.getAttribute('data-email') || ''
      try {
        await navigator.clipboard.writeText(email)
        const originalText = badge.textContent
        badge.textContent = '¡COPIADO! [200 OK]'
        badge.className = 'px-2 py-1 bg-signal-emerald text-black text-xs font-mono transition-all font-bold'
        btnCopy.classList.add('border-signal-emerald')

        setTimeout(() => {
          badge.textContent = originalText
          badge.className = 'px-2 py-1 bg-slate-900 text-white dark:bg-white dark:text-black text-xs font-mono group-hover:bg-signal-emerald group-hover:text-black transition-colors'
          btnCopy.classList.remove('border-signal-emerald')
        }, 2200)
      } catch (err) {
        window.location.href = `mailto:${email}`
      }
    })
  }

  setupCopyButton()
  document.addEventListener('astro:page-load', setupCopyButton)
</script>
