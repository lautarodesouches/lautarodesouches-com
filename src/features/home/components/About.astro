---
import { portfolioData } from '../data/portfolio.data'
const { about } = portfolioData
---

<section id="about" class="py-28 px-6 bg-white dark:bg-black">
  <div class="max-w-6xl mx-auto fade-in-view">
    <div class="grid lg:grid-cols-12 gap-16">
      <div class="lg:col-span-5 space-y-8">
        <div class="space-y-4">
          <p class="text-sm font-mono text-brand dark:text-tech uppercase tracking-widest">
            Sobre mí
          </p>
          <h2
            class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white leading-snug"
          >
            Construyo productos digitales que funcionan
          </h2>
        </div>

        <dl class="space-y-3 pt-4">
          {
            about.quickData?.map((item) => (
              <div class="flex items-baseline gap-3 text-sm">
                <dt class="text-slate-400 dark:text-gray-500 font-mono shrink-0">{item.label}</dt>
                <dd class="text-slate-900 dark:text-white font-medium m-0">{item.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div
        class="lg:col-span-7 space-y-6 text-lg text-slate-600 dark:text-gray-400 leading-8"
      >
        {about.description.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </div>
</section>
