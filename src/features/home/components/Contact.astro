---
import { portfolioData } from '../data/portfolio.data'
const { contact } = portfolioData
---

<section id="contact" class="py-28 px-6 bg-slate-50 dark:bg-zinc-950">
  <div class="max-w-6xl mx-auto fade-in-view">
    <div class="grid lg:grid-cols-12 gap-16">
      <div class="lg:col-span-5 space-y-6">
        <p class="text-sm font-mono text-brand dark:text-tech uppercase tracking-widest">
          Contacto
        </p>
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          Hablemos
        </h2>
        <p class="text-lg text-slate-600 dark:text-gray-400 leading-relaxed">
          {contact.message}
        </p>
      </div>

      <div class="lg:col-span-7 flex flex-col justify-center">
        <ul class="space-y-4">
          <li>
            <a
              href={`mailto:${contact.email}`}
              class="group flex items-center justify-between p-5 rounded-lg bg-white dark:bg-black border border-slate-200 dark:border-white/10 hover:border-brand/50 dark:hover:border-tech/50 transition-colors"
            >
              <div class="flex items-center gap-4">
                <div
                  class="w-10 h-10 rounded-full bg-brand/10 dark:bg-tech/10 flex items-center justify-center"
                >
                  <svg
                    class="w-4 h-4 text-brand dark:text-tech"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path
                      d="M1.5 8.67v8.58a3 3 0 003 3h15a3 3 0 003-3V8.67l-8.928 5.493a3 3 0 01-3.144 0L1.5 8.67z"
                    ></path>
                    <path
                      d="M22.5 6.908V6.75a3 3 0 00-3-3h-15a3 3 0 00-3 3v.158l9.714 5.978a1.5 1.5 0 001.572 0L22.5 6.908z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <p
                    class="text-xs font-mono text-slate-400 dark:text-gray-500 uppercase tracking-wider"
                  >
                    Email
                  </p>
                  <p class="text-sm font-medium text-slate-900 dark:text-white">
                    {contact.email}
                  </p>
                </div>
              </div>
              <span
                class="text-sm text-brand dark:text-tech opacity-0 group-hover:opacity-100 transition-opacity"
                >Enviar →</span
              >
            </a>
          </li>

          <li>
            <a
              href={contact.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between p-5 rounded-lg bg-white dark:bg-black border border-slate-200 dark:border-white/10 hover:border-brand/50 dark:hover:border-tech/50 transition-colors"
            >
              <div class="flex items-center gap-4">
                <div
                  class="w-10 h-10 rounded-full bg-slate-100 dark:bg-white/5 flex items-center justify-center"
                >
                  <svg
                    class="w-4 h-4 text-slate-600 dark:text-gray-400"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path
                      d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <p
                    class="text-xs font-mono text-slate-400 dark:text-gray-500 uppercase tracking-wider"
                  >
                    LinkedIn
                  </p>
                  <p class="text-sm font-medium text-slate-900 dark:text-white">
                    Perfil profesional
                  </p>
                </div>
              </div>
              <span
                class="text-sm text-brand dark:text-tech opacity-0 group-hover:opacity-100 transition-opacity"
                >Abrir →</span
              >
            </a>
          </li>

          <li>
            <a
              href={contact.github}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between p-5 rounded-lg bg-white dark:bg-black border border-slate-200 dark:border-white/10 hover:border-brand/50 dark:hover:border-tech/50 transition-colors"
            >
              <div class="flex items-center gap-4">
                <div
                  class="w-10 h-10 rounded-full bg-slate-100 dark:bg-white/5 flex items-center justify-center"
                >
                  <svg
                    class="w-4 h-4 text-slate-600 dark:text-gray-400"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path
                      d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <p
                    class="text-xs font-mono text-slate-400 dark:text-gray-500 uppercase tracking-wider"
                  >
                    GitHub
                  </p>
                  <p class="text-sm font-medium text-slate-900 dark:text-white">Repositorios</p>
                </div>
              </div>
              <span
                class="text-sm text-brand dark:text-tech opacity-0 group-hover:opacity-100 transition-opacity"
                >Abrir →</span
              >
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
