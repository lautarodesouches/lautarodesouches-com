---
import { portfolioData } from '../data/portfolio.data'
const { hero } = portfolioData
---

<section
  class="min-h-screen flex items-center bg-surface text-gray-100 border-b border-surface-border overflow-hidden relative selection:bg-brand-light/30 selection:text-brand-light"
>
  <div
    class="absolute inset-0 bg-[linear-gradient(to_right,var(--color-surface-border)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-surface-border)_1px,transparent_1px)] bg-[size:24px_24px] opacity-40 dark:opacity-20"
  >
  </div>
  <div
    class="absolute top-20 left-1/4 w-96 h-96 bg-brand/10 rounded-full blur-[128px] pointer-events-none"
  >
  </div>
  <div
    class="absolute bottom-20 right-1/4 w-96 h-96 bg-tech/10 rounded-full blur-[128px] pointer-events-none"
  >
  </div>

  <div
    class="max-w-7xl mx-auto px-6 w-full grid lg:grid-cols-12 gap-12 items-center relative z-10 pt-20 pb-20"
  >
    <div class="lg:col-span-5 space-y-8">
      <div class="hero-item" style="--delay: 0s">
        <div
          class="inline-flex items-center gap-2 px-3 py-1.5 text-xs font-mono font-medium text-indigo-700 dark:text-tech bg-indigo-50 dark:bg-tech-dim/20 rounded border border-indigo-200 dark:border-tech-dim/50 backdrop-blur-sm"
        >
          <span class="relative flex h-2 w-2">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-500 dark:bg-tech opacity-75"
            ></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-600 dark:bg-tech"
            ></span>
          </span>
          Available for New Projects
        </div>
      </div>

      <h1
        class="hero-item text-5xl md:text-7xl font-bold tracking-tight text-slate-900 dark:text-white leading-[1.1]"
        style="--delay: 0.1s"
      >
        Ingeniería <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand to-tech"
          >Full-Stack</span
        > <br />
        Escalable.
      </h1>

      <div class="hero-item pl-4 border-l-2 border-brand/30" style="--delay: 0.2s">
        <p class="text-sm md:text-base font-mono text-brand mb-2 font-medium">
          Next.js • NestJS • Java Spring
        </p>
        <p
          class="text-lg text-slate-700 dark:text-gray-400 leading-relaxed max-w-lg font-medium dark:font-normal"
        >
          {hero.intro}
        </p>
      </div>

      <div class="hero-item flex flex-wrap gap-4 pt-4" style="--delay: 0.3s">
        <a
          href="#projects"
          class="px-8 py-4 rounded-lg bg-brand text-white font-semibold hover:bg-brand-dark transition-all shadow-lg shadow-brand/20 hover:shadow-brand/40 flex items-center gap-2 hover:scale-[1.02] active:scale-[0.98]"
        >
          {hero.cta}
        </a>
        <a
          href="#skills"
          class="px-8 py-4 rounded-lg border border-slate-300 dark:border-surface-border text-slate-700 dark:text-gray-300 font-semibold transition-all flex items-center gap-2 hover:border-slate-800 hover:text-slate-900 hover:bg-white dark:hover:bg-transparent dark:hover:text-white bg-white dark:bg-transparent shadow-sm dark:shadow-none hover:scale-[1.02] active:scale-[0.98]"
        >
          {hero.contactCta}
        </a>
      </div>
    </div>

    <div class="hidden lg:block lg:col-span-1"></div>

    <div class="lg:col-span-6 relative hero-card-enter">
      <div
        class="animate-float relative rounded-xl bg-white dark:bg-[#0F0F0F] border border-slate-200 dark:border-gray-800 shadow-2xl overflow-hidden"
      >
        <div
          class="flex items-center justify-between px-4 py-3 bg-slate-50 dark:bg-[#161616] border-b border-slate-200 dark:border-gray-800"
        >
          <div class="flex gap-2">
            <div class="w-3 h-3 rounded-full bg-[#FF5F56] border border-black/10"></div>
            <div class="w-3 h-3 rounded-full bg-[#FFBD2E] border border-black/10"></div>
            <div class="w-3 h-3 rounded-full bg-[#27C93F] border border-black/10"></div>
          </div>
          <div class="text-xs text-slate-500 dark:text-gray-500 font-mono">portfolio.ts</div>
          <div class="w-12"></div>
        </div>

        <div
          class="p-6 font-mono text-xs md:text-sm leading-7 text-slate-800 dark:text-gray-300 overflow-x-auto selection:bg-brand/10"
        >
          <p>
            <span class="text-purple-600 dark:text-purple-400">interface</span>
            <span class="text-amber-600 dark:text-yellow-200">Developer</span>
            <span class="text-slate-500 dark:text-gray-500">{"{"}</span>
          </p>
          <p class="pl-4">
            <span class="text-blue-600 dark:text-brand-light">role</span>: <span
              class="text-emerald-600 dark:text-tech">'Full-Stack Engineer'</span
            >;
          </p>
          <p class="pl-4">
            <span class="text-blue-600 dark:text-brand-light">location</span>: <span
              class="text-emerald-600 dark:text-tech">'Argentina'</span
            >;
          </p>
          <p class="pl-4">
            <span class="text-blue-600 dark:text-brand-light">stack</span>: <span
              class="text-slate-500 dark:text-gray-500">{"["}</span
            >
          </p>
          <p class="pl-8">
            <span class="text-emerald-600 dark:text-tech">'Next.js'</span>, <span
              class="text-slate-400 dark:text-gray-500">// Frontend</span
            >
          </p>
          <p class="pl-8">
            <span class="text-emerald-600 dark:text-tech">'NestJS'</span>, <span
              class="text-slate-400 dark:text-gray-500">// Backend</span
            >
          </p>
          <p class="pl-8">
            <span class="text-emerald-600 dark:text-tech">'Java Spring'</span>
            <span class="text-slate-400 dark:text-gray-500">// Enterprise</span>
          </p>
          <p class="pl-4"><span class="text-slate-500 dark:text-gray-500">{"]"}</span>;</p>
          <p class="pl-4">
            <span class="text-blue-600 dark:text-brand-light">focus</span>: <span
              class="text-emerald-600 dark:text-tech">'End-to-End Scalability'</span
            >;
          </p>
          <p class="text-slate-500 dark:text-gray-500">{"}"}</p>
          <br />
          <p class="text-slate-400 dark:text-gray-500">{'// Let\'s build something amazing'}</p>
          <p>
            <span class="text-purple-600 dark:text-brand-light">const</span>
            <span class="text-slate-900 dark:text-white">me</span> = <span
              class="text-purple-600 dark:text-brand-light">new</span
            >
            <span class="text-amber-600 dark:text-yellow-200">Developer</span>();
          </p>
          <div class="flex items-center gap-2 mt-2">
            <span class="text-slate-900 dark:text-white">me</span>.<span
              class="text-amber-600 dark:text-yellow-200">deploy</span
            >(<span class="text-emerald-600 dark:text-tech">'Production'</span>);
            <span class="animate-pulse w-2 h-4 bg-brand block"></span>
          </div>
        </div>

        <div
          class="absolute top-0 right-0 w-full h-full bg-gradient-to-bl from-brand/5 to-transparent pointer-events-none"
        >
        </div>
      </div>
      <div
        class="absolute -top-10 -right-10 w-32 h-32 bg-tech/10 rounded-full blur-2xl -z-10"
      >
      </div>
    </div>
  </div>
</section>

<style>
  .hero-item {
    opacity: 0;
    transform: translateY(20px);
    animation: fade-up 0.5s ease forwards;
    animation-delay: var(--delay, 0s);
  }

  .hero-card-enter {
    opacity: 0;
    transform: translateX(50px);
    animation: card-enter 0.8s ease forwards 0.5s;
  }

  @keyframes fade-up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes card-enter {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-15px);
    }
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }
</style>
