---
import { Cpu, ShieldCheck } from 'lucide-astro'
import SectionTitle from '../../../shared/components/SectionTitle.astro'
import Badge from '../../../shared/components/Badge.astro'
import styles from '../styles/SkillsMatrix.module.css'
import { skillDomains, architecturePrinciples } from '../data/skills.data'
---

<section class={styles['skills-section']} id="stack">
  <div class="container">
    <SectionTitle
      eyebrow="Stack Tecnológico & Arquitectura"
      title="Herramientas de Precisión y Principios de Ingeniería"
      description="Especialización profunda en el ecosistema JavaScript/TypeScript, arquitectura de microservicios y prácticas de ingeniería preparadas para entornos empresariales."
    />

    <div class={styles['skills-section__domains-grid']}>
      {skillDomains.map((domain) => (
        <div class={styles['skills-section__domain-card']} data-skill-card>
          <div class={styles['skills-section__domain-header']}>
            <div class={styles['skills-section__domain-top']}>
              <h3 class={styles['skills-section__domain-title']}>{domain.title}</h3>
              <Badge variant="primary" size="sm">
                {domain.tag}
              </Badge>
            </div>
            <p class={styles['skills-section__domain-desc']}>{domain.description}</p>
          </div>

          <div class={styles['skills-section__tags-wrap']}>
            {domain.skills.map((skill) => (
              <Badge variant="tech" size="sm">
                {skill}
              </Badge>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class={styles['skills-section__principles-wrap']} data-principles-wrap>
      <h3 class={styles['skills-section__principles-title']}>
        <ShieldCheck size={20} />
        <span>Pilares Fundamentales de Arquitectura</span>
      </h3>

      <div class={styles['skills-section__principles-grid']}>
        {architecturePrinciples.map((principle) => (
          <div class={styles['skills-section__principle-card']}>
            <span class={styles['skills-section__principle-num']}>{principle.number}</span>
            <div class={styles['skills-section__principle-content']}>
              <span class={styles['skills-section__principle-tag']}>{principle.tag}</span>
              <h4 class={styles['skills-section__principle-heading']}>{principle.title}</h4>
              <p class={styles['skills-section__principle-desc']}>{principle.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const skillCards = document.querySelectorAll('[data-skill-card]')
  const principlesWrap = document.querySelector('[data-principles-wrap]')

  if (skillCards.length > 0) {
    gsap.from(skillCards, {
      scrollTrigger: {
        trigger: '#stack',
        start: 'top 80%',
      },
      opacity: 0,
      y: 25,
      duration: 0.7,
      stagger: 0.12,
      ease: 'power3.out',
    })
  }

  if (principlesWrap) {
    gsap.from(principlesWrap, {
      scrollTrigger: {
        trigger: principlesWrap,
        start: 'top 85%',
      },
      opacity: 0,
      y: 20,
      duration: 0.7,
      ease: 'power3.out',
    })
  }
</script>

