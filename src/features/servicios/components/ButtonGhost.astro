---
interface Props {
  href: string
  external?: boolean
  class?: string
}
const { href, external = false, class: className } = Astro.props
const target = external ? '_blank' : undefined
const rel = external ? 'noopener noreferrer' : undefined
---

<a
  href={href}
  target={target}
  rel={rel}
  class:list={[
    'inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-semibold text-sm transition-all border border-slate-300 dark:border-zinc-700 text-slate-800 dark:text-zinc-100 hover:border-slate-900 hover:text-slate-950 hover:bg-slate-100 dark:hover:border-white dark:hover:text-white dark:hover:bg-zinc-900 bg-transparent shadow-sm hover:scale-[1.02] active:scale-[0.98] cursor-pointer',
    className,
  ]}
>
  <slot />
</a>
