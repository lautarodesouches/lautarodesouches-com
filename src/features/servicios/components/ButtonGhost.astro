---
interface Props {
  href: string
  external?: boolean
  class?: string
}
const { href, external = false, class: className } = Astro.props
const target = external ? '_blank' : undefined
const rel = external ? 'noopener noreferrer' : undefined
---

<a
  href={href}
  target={target}
  rel={rel}
  class:list={[
    'inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-semibold text-sm transition-all border border-slate-300 dark:border-surface-border text-slate-700 dark:text-gray-300 hover:border-slate-900 hover:text-slate-900 hover:bg-white dark:hover:border-white dark:hover:text-white bg-white dark:bg-transparent shadow-sm hover:scale-[1.02] active:scale-[0.98]',
    className,
  ]}
>
  <slot />
</a>
