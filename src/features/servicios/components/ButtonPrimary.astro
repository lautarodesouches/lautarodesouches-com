---
interface Props {
  href: string
  external?: boolean
  class?: string
}
const { href, external = true, class: className } = Astro.props
const target = external ? '_blank' : undefined
const rel = external ? 'noopener noreferrer' : undefined
---

<a
  href={href}
  target={target}
  rel={rel}
  class:list={[
    'inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-semibold text-sm transition-all bg-brand text-white hover:bg-brand-dark shadow-lg shadow-brand/20 hover:shadow-brand/40 hover:scale-[1.02] active:scale-[0.98]',
    className,
  ]}
>
  <slot />
</a>
