---
interface Props {
  href: string
  external?: boolean
  class?: string
}
const { href, external = true, class: className } = Astro.props
const target = external ? '_blank' : undefined
const rel = external ? 'noopener noreferrer' : undefined
---

<a
  href={href}
  target={target}
  rel={rel}
  class:list={[
    'inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-semibold text-sm transition-all bg-slate-900 text-white hover:bg-slate-800 dark:bg-white dark:text-slate-950 dark:hover:bg-zinc-200 shadow-md hover:scale-[1.02] active:scale-[0.98] cursor-pointer',
    className,
  ]}
>
  <slot />
</a>
