---
import { Briefcase, GraduationCap, Languages } from 'lucide-astro'
import SectionTitle from '../../../shared/components/SectionTitle.astro'
import Badge from '../../../shared/components/Badge.astro'
import styles from '../styles/ExperienceTimeline.module.css'
import { experienceItems, educationItems, languages } from '../data/experience.data'
---

<section class={styles.experience} id="trayectoria">
  <div class="container">
    <SectionTitle
      eyebrow="Trayectoria & Educación"
      title="Experiencia Profesional y Fundamentos Técnicos"
      description="Más de 5 años diseñando soluciones para clientes comerciales y productos SaaS, respaldados por formación universitaria y actualización continua en tecnologías de punta."
    />

    <div class={styles.experience__layout}>
      <div class={styles['experience__work-column']}>
        {experienceItems.map((item) => (
          <article class={styles.experience__card} data-exp-card>
            <div class={styles['experience__card-header']}>
              <div class={styles['experience__top-row']}>
                <span class={styles.experience__period}>{item.period}</span>
                <Badge variant="primary" size="sm">
                  Full Stack Lead
                </Badge>
              </div>
              <h3 class={styles.experience__role}>{item.role}</h3>
              <span class={styles.experience__company}>
                {item.company} &bull; {item.location}
              </span>
            </div>

            <p class={styles.experience__desc}>{item.description}</p>

            <div class={styles.experience__highlights}>
              {item.highlights.map((highlight) => (
                <div class={styles['experience__highlight-item']}>
                  <span class={styles['experience__highlight-bullet']} />
                  <span>{highlight}</span>
                </div>
              ))}
            </div>

            <div class={styles.experience__techs}>
              {item.technologies.map((tech) => (
                <Badge variant="tech" size="sm">
                  {tech}
                </Badge>
              ))}
            </div>
          </article>
        ))}
      </div>

      <div class={styles['experience__side-column']}>
        <div class={styles['experience__sub-block']} data-exp-card>
          <h3 class={styles['experience__sub-title']}>
            <GraduationCap size={20} />
            <span>Educación Universitaria</span>
          </h3>

          <div class={styles['experience__edu-list']}>
            {educationItems.map((edu) => (
              <div class={styles['experience__edu-item']}>
                <h4 class={styles['experience__edu-degree']}>{edu.degree}</h4>
                <span class={styles['experience__edu-institution']}>{edu.institution}</span>
                <div class={styles['experience__edu-meta']}>
                  <span class={styles['experience__edu-period']}>{edu.period}</span>
                  <Badge variant="success" size="sm">
                    {edu.status}
                  </Badge>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class={styles['experience__sub-block']} data-exp-card>
          <h3 class={styles['experience__sub-title']}>
            <Languages size={20} />
            <span>Idiomas</span>
          </h3>

          <div class={styles['experience__lang-list']}>
            {languages.map((lang) => (
              <div class={styles['experience__lang-item']}>
                <div class={styles['experience__lang-header']}>
                  <span class={styles['experience__lang-name']}>{lang.language}</span>
                  <span class={styles['experience__lang-level']}>{lang.level}</span>
                </div>
                <p class={styles['experience__lang-details']}>{lang.details}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const expCards = document.querySelectorAll('[data-exp-card]')

  if (expCards.length > 0) {
    gsap.from(expCards, {
      scrollTrigger: {
        trigger: '#trayectoria',
        start: 'top 80%',
      },
      opacity: 0,
      y: 30,
      duration: 0.7,
      stagger: 0.15,
      ease: 'power3.out',
    })
  }
</script>

