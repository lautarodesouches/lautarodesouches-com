---
import { MessageSquare, Mail, Linkedin, Github, ArrowUpRight, MapPin, Clock } from 'lucide-astro'
import SectionTitle from '../../../shared/components/SectionTitle.astro'
import Badge from '../../../shared/components/Badge.astro'
import styles from '../styles/Contact.module.css'
import { contactChannels } from '../data/contact.data'
---

<section class={styles.contact} id="contacto">
  <div class="container">
    <SectionTitle
      eyebrow="Canales de Contacto"
      title="Iniciemos una Conversación"
      description="Ya sea que necesites una plataforma web de alto rendimiento para tu negocio o busques incorporar un desarrollador frontend/fullstack con experiencia a tu equipo técnico."
    />

    <div class={styles.contact__grid}>
      {contactChannels.map((channel) => (
        <div
          class={`${styles.contact__card} ${channel.highlight ? styles['contact__card--highlight'] : ''}`}
          data-contact-card
        >
          <div class={styles.contact__left}>
            <div class={styles['contact__icon-wrap']}>
              {channel.id === 'whatsapp' && <MessageSquare size={24} />}
              {channel.id === 'email' && <Mail size={24} />}
              {channel.id === 'linkedin' && <Linkedin size={24} />}
              {channel.id === 'github' && <Github size={24} />}
            </div>
            <div class={styles.contact__info}>
              <span class={styles.contact__label}>{channel.label}</span>
              <span class={styles.contact__value}>{channel.value}</span>
            </div>
          </div>

          <a
            href={channel.href}
            target={channel.isExternal ? '_blank' : undefined}
            rel={channel.isExternal ? 'noopener noreferrer' : undefined}
            class={styles['contact__action-btn']}
          >
            <span>{channel.actionLabel}</span>
            <ArrowUpRight size={15} />
          </a>
        </div>
      ))}
    </div>

    <div class={styles['contact__summary-box']} data-contact-summary>
      <div class={styles['contact__summary-content']}>
        <h4 class={styles['contact__summary-title']}>Disponibilidad Inmediata para Proyectos</h4>
        <p class={styles['contact__summary-desc']}>
          Ubicado en Ramos Mejía, Buenos Aires (GMT-3). Modalidad Remota o Híbrida. Tiempo estimado de respuesta menor a 24 horas hábiles.
        </p>
      </div>

      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <Badge variant="success" dot={true}>
          <Clock size={13} />
          Respuesta &lt; 24h
        </Badge>
        <Badge variant="tech">
          <MapPin size={13} />
          Buenos Aires, Argentina
        </Badge>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const contactCards = document.querySelectorAll('[data-contact-card]')
  const contactSummary = document.querySelector('[data-contact-summary]')

  if (contactCards.length > 0) {
    gsap.from(contactCards, {
      scrollTrigger: {
        trigger: '#contacto',
        start: 'top 80%',
      },
      opacity: 0,
      y: 25,
      duration: 0.6,
      stagger: 0.1,
      ease: 'power3.out',
    })
  }

  if (contactSummary) {
    gsap.from(contactSummary, {
      scrollTrigger: {
        trigger: contactSummary,
        start: 'top 85%',
      },
      opacity: 0,
      y: 20,
      duration: 0.6,
      ease: 'power3.out',
    })
  }
</script>

