---
import { ArrowUpRight, Github, Lock } from 'lucide-astro'
import Badge from '../../../shared/components/Badge.astro'
import styles from '../styles/ProjectCard.module.css'
import type { Project } from '../../../data/portfolio.data'

interface Props {
  project: Project
  reversed?: boolean
}

const { project, reversed = false } = Astro.props

const cardClasses = [
  styles['project-card'],
  reversed ? styles['project-card--reversed'] : '',
].filter(Boolean).join(' ')
---

<article class={cardClasses} data-project-card>
  <div class={styles['project-card__grid']}>
    <div class={styles['project-card__content']}>
      <div class={styles['project-card__meta']}>
        <Badge variant="primary" size="sm">
          {project.badge}
        </Badge>
        <span class={styles['project-card__type']}>{project.type}</span>
      </div>

      <h3 class={styles['project-card__title']}>{project.title}</h3>
      <p class={styles['project-card__desc']}>{project.description}</p>

      <div class={styles['project-card__challenge-box']}>
        <div class={styles['project-card__challenge-item']}>
          <span class={styles['project-card__challenge-label']}>Desafío</span>
          <span class={styles['project-card__challenge-text']}>{project.problem}</span>
        </div>
        <div class={styles['project-card__challenge-item']}>
          <span class={styles['project-card__challenge-label']}>Solución & Arquitectura</span>
          <span class={styles['project-card__challenge-text']}>{project.solution}</span>
        </div>
      </div>

      <div class={styles['project-card__metrics']}>
        {project.metrics.map((metric) => (
          <div class={styles['project-card__metric']}>
            <span class={styles['project-card__metric-val']}>{metric.value}</span>
            <span class={styles['project-card__metric-lbl']}>{metric.label}</span>
          </div>
        ))}
      </div>

      <div class={styles['project-card__tech-list']}>
        {project.tech.map((item) => (
          <Badge variant="tech" size="sm">
            {item}
          </Badge>
        ))}
      </div>

      <div class={styles['project-card__actions']}>
        {project.demoUrl && (
          <a
            href={project.demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class={`${styles['project-card__btn']} ${styles['project-card__btn--primary']}`}
          >
            <span>Ver Plataforma en Vivo</span>
            <ArrowUpRight size={16} />
          </a>
        )}

        {project.isPrivateRepo ? (
          <span class={`${styles['project-card__btn']} ${styles['project-card__btn--secondary']}`}>
            <Lock size={15} />
            <span>Código Privado (NDA)</span>
          </span>
        ) : (
          project.repoUrl && (
            <a
              href={project.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class={`${styles['project-card__btn']} ${styles['project-card__btn--secondary']}`}
            >
              <Github size={16} />
              <span>Ver Repositorio</span>
            </a>
          )
        )}
      </div>
    </div>

    <div class={styles['project-card__media']}>
      <div class={styles['project-card__media-inner']}>
        <img
          src={project.image}
          alt={`Captura del proyecto ${project.title}`}
          loading="lazy"
          decoding="async"
          class={styles['project-card__image']}
        />
      </div>
    </div>
  </div>
</article>

