---
import type { Project } from '../types'

interface Props {
  project: Project
  index: number
  totalProjects: number
  isActive?: boolean
}

const { project, index, totalProjects, isActive = false } = Astro.props
const isPrivate = project.isPrivateRepo
---

<article
  class:list={['project-story-item', { 'is-active': isActive }]}
  data-index={index}
  id={`project-story-${project.id}`}
>
  <div class="story-content">
    <div class="story-telemetry">
      <span class="story-badge">
        [ {String(index + 1).padStart(2, '0')} / {String(totalProjects).padStart(2, '0')} ] // {project.badge}
      </span>
      <span class="story-type">{project.type}</span>
    </div>

    <h3 class="story-title">{project.title}</h3>

    <div class="story-narrative">
      <div class="narrative-block">
        <span class="narrative-label">// DESAFÍO DE NEGOCIO</span>
        <p class="narrative-text">{project.problem}</p>
      </div>
      <div class="narrative-block">
        <span class="narrative-label">// SOLUCIÓN DE ARQUITECTURA</span>
        <p class="narrative-text">{project.solution}</p>
      </div>
    </div>

    <div class="story-metrics">
      {project.metrics.map((metric) => (
        <div class="metric-card">
          <span class="metric-label">{metric.label}</span>
          <span class="metric-value">{metric.value}</span>
        </div>
      ))}
    </div>

    <div class="story-stack">
      <span class="stack-heading">Stack Tecnológico</span>
      <div class="stack-pills">
        {project.tech.map((techItem) => (
          <span class="tech-pill">{techItem}</span>
        ))}
      </div>
    </div>

    <div class="story-actions">
      <a
        href={project.demoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="action-btn action-btn--primary"
      >
        <span>Ver Proyecto en Producción</span>
        <span class="action-arrow" aria-hidden="true">↗</span>
      </a>

      {isPrivate ? (
        <span class="private-badge">[ REPOSITORIO PRIVADO // NDA ]</span>
      ) : (
        <a
          href={project.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="action-btn action-btn--secondary"
        >
          <span>Código en GitHub</span>
          <span class="action-arrow" aria-hidden="true">↗</span>
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .project-story-item {
    min-height: 92vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    opacity: 0.32;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-story-item.is-active {
    opacity: 1;
  }

  .project-story-item:last-child {
    border-bottom: none;
    min-height: 85vh;
  }

  .story-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .story-telemetry {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .story-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .story-type {
    font-family: var(--font-mono);
    font-size: 10px;
    color: rgba(255, 255, 255, 0.35);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .story-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 2.5vw, 2.4rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .story-narrative {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .narrative-block {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .narrative-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .narrative-text {
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .story-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    padding: 1.15rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .metric-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .metric-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .metric-value {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .story-stack {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .stack-heading {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  .stack-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tech-pill {
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1;
    color: rgba(255, 255, 255, 0.65);
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.35rem 0.6rem;
    border-radius: 4px;
    white-space: nowrap;
  }

  .story-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding-top: 0.25rem;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    padding: 0.65rem 1.15rem;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
  }

  .action-btn--primary {
    background-color: #FFFFFF;
    color: #0A0A0A;
    font-weight: 600;
  }

  .action-btn--primary:hover {
    background-color: #E6E6E6;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(255, 255, 255, 0.15);
  }

  .action-btn--secondary {
    background-color: rgba(255, 255, 255, 0.04);
    color: #FFFFFF;
    font-weight: 500;
    border: 1px solid rgba(255, 255, 255, 0.14);
  }

  .action-btn--secondary:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-1px);
  }

  .private-badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1;
    color: var(--text-muted);
    border: 1px solid rgba(255, 255, 255, 0.1);
    background-color: rgba(255, 255, 255, 0.02);
    padding: 0.65rem 0.95rem;
    border-radius: 9999px;
    letter-spacing: 0.04em;
    user-select: none;
  }

  .action-arrow {
    font-size: 12px;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .action-btn:hover .action-arrow {
    transform: translate(2px, -2px);
  }

  @media (max-width: 1023px) {
    .project-story-item {
      min-height: auto;
      padding: 2rem 0 3rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      opacity: 0.35;
      transition: opacity 0.35s ease;
    }

    .project-story-item.is-active {
      opacity: 1;
    }

    .project-story-item:last-child {
      border-bottom: none;
      padding-bottom: 1rem;
    }

    .story-content {
      gap: 1.25rem;
    }

    .story-title {
      font-size: clamp(1.4rem, 5.5vw, 1.85rem);
      line-height: 1.15;
    }

    .story-narrative {
      gap: 0.85rem;
    }

    .narrative-text {
      font-size: 13px;
      line-height: 1.55;
    }

    .story-metrics {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;
      padding: 0.85rem 0;
    }

    .metric-label {
      font-size: 8.5px;
    }

    .metric-value {
      font-size: 10.5px;
    }

    .story-actions {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .action-btn,
    .private-badge {
      font-size: 10px;
      padding: 0.55rem 0.9rem;
    }
  }

  @media (max-width: 768px) {
    .project-story-item {
      padding: 1.5rem 0 2.5rem;
    }

    .story-title {
      font-size: 1.35rem;
    }

    .story-metrics {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }

    .story-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .action-btn,
    .private-badge {
      justify-content: center;
      text-align: center;
      padding: 0.6rem 1rem;
    }
  }
</style>

