---
---

<section class="services-contact-section" id="contacto" aria-labelledby="services-contact-title">
  <div class="services-contact-container">
    <header class="contact-header">
      <div class="contact-tag">
        <span class="section-tag">04 // CONTACTO DIRECTO & CONTRATACIÓN</span>
      </div>

      <h2 class="contact-title" id="services-contact-title">
        Iniciemos tu próximo proyecto.
      </h2>

      <p class="contact-desc">
        Completa el formulario de intake para coordinar una llamada o enviar tus requerimientos directamente vía WhatsApp sin intermediarios ni demoras.
      </p>
    </header>

    <div class="contact-layout">
      <div class="form-card">
        <form id="intake-form" class="intake-form" novalidate>
          <div class="form-row form-row--two">
            <div class="form-group">
              <label for="client-name" class="form-label">[ NOMBRE / EMPRESA ] *</label>
              <input
                type="text"
                id="client-name"
                name="clientName"
                class="form-input"
                placeholder="Ej. Martín Gómez // Acme Corp"
                required
              />
            </div>

            <div class="form-group">
              <label for="client-email" class="form-label">[ CORREO CORPORATIVO ]</label>
              <input
                type="email"
                id="client-email"
                name="clientEmail"
                class="form-input"
                placeholder="martin@acmecorp.com"
              />
            </div>
          </div>

          <div class="form-row form-row--two">
            <div class="form-group">
              <label for="project-type" class="form-label">[ TIPO DE PROYECTO ] *</label>
              <select id="project-type" name="projectType" class="form-select" required>
                <option value="Sitios Web Corporativos & Landing Pages">Sitios Web Corporativos & Landing Pages de Conversión</option>
                <option value="Plataformas Web & Software a Medida">Plataformas Web & Software a Medida (B2B)</option>
                <option value="Auditoría & Rescate de Rendimiento">Auditoría & Rescate de Rendimiento Web</option>
                <option value="Consultoría / Proyecto a Medida">Consultoría / Requerimiento Personalizado</option>
              </select>
            </div>

            <div class="form-group">
              <label for="project-budget" class="form-label">[ RANGO DE INVERSIÓN ESTIMADO ]</label>
              <select id="project-budget" name="projectBudget" class="form-select">
                <option value="A definir según propuesta">A definir según propuesta técnica</option>
                <option value="Hasta USD 1.500">Hasta USD 1.500</option>
                <option value="USD 1.500 — USD 3.500">USD 1.500 — USD 3.500</option>
                <option value="USD 3.500 — USD 7.000">USD 3.500 — USD 7.000</option>
                <option value="Más de USD 7.000">Más de USD 7.000</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="project-details" class="form-label">[ DESCRIPCIÓN DEL DESAFÍO O PROBLEMA ] *</label>
            <textarea
              id="project-details"
              name="projectDetails"
              class="form-textarea"
              rows="4"
              placeholder="Detalla brevemente el objetivo del proyecto, funcionalidades clave o cuellos de botella actuales..."
              required
            ></textarea>
          </div>

          <div class="form-action-area">
            <button type="submit" id="submit-intake-btn" class="magnetic-submit-btn">
              <span class="btn-text">Enviar Solicitud vía WhatsApp</span>
              <span class="btn-arrow" aria-hidden="true">↗</span>
            </button>
            <span class="form-notice">// SE ABRIRÁ UNA CONVERSACIÓN PRIVADA CON TUS DATOS CARGADOS</span>
          </div>
        </form>
      </div>

      <aside class="contact-channels-sidebar">
        <div class="sidebar-box">
          <div class="sidebar-box__header">
            <span class="box-status-dot" aria-hidden="true"></span>
            <span class="box-heading">CANALES DIRECTOS INMEDIATOS</span>
          </div>

          <div class="direct-channels-list">
            <a
              href="https://wa.me/541130111503?text=Hola%20Lautaro,%20estoy%20interesado%20en%20conversar%20sobre%20un%20proyecto."
              target="_blank"
              rel="noopener noreferrer"
              class="direct-channel-item direct-channel-item--highlight"
            >
              <div class="channel-info">
                <span class="channel-label">// WHATSAPP DIRECTO</span>
                <span class="channel-val">+54 11 3011-1503</span>
                <span class="channel-sub">Chat prioritario con Lautaro Desouches</span>
              </div>
              <span class="channel-arrow" aria-hidden="true">↗</span>
            </a>

            <a
              href="mailto:lautarodesouches@outlook.com"
              class="direct-channel-item"
            >
              <div class="channel-info">
                <span class="channel-label">// EMAIL PROFESIONAL</span>
                <span class="channel-val">lautarodesouches@outlook.com</span>
                <span class="channel-sub">Para requerimientos formales, pliegos y NDA</span>
              </div>
              <span class="channel-arrow" aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="sidebar-guarantees">
            <span class="guarantee-heading">// GARANTÍAS DE SERVICIO</span>
            <ul class="guarantee-list">
              <li class="guarantee-item">
                <span class="guarantee-dash">—</span>
                <span>Acuerdo de Confidencialidad (NDA) disponible</span>
              </li>
              <li class="guarantee-item">
                <span class="guarantee-dash">—</span>
                <span>Trato directo con el ingeniero responsable</span>
              </li>
              <li class="guarantee-item">
                <span class="guarantee-dash">—</span>
                <span>Presupuestos cerrados sin sobrecostos ocultos</span>
              </li>
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const form = document.getElementById('intake-form') as HTMLFormElement | null
  const submitBtn = document.getElementById('submit-intake-btn') as HTMLButtonElement | null

  if (form) {
    form.addEventListener('submit', (e: Event) => {
      e.preventDefault()

      const clientName = (document.getElementById('client-name') as HTMLInputElement)?.value.trim()
      const clientEmail = (document.getElementById('client-email') as HTMLInputElement)?.value.trim()
      const projectType = (document.getElementById('project-type') as HTMLSelectElement)?.value
      const projectBudget = (document.getElementById('project-budget') as HTMLSelectElement)?.value
      const projectDetails = (document.getElementById('project-details') as HTMLTextAreaElement)?.value.trim()

      if (!clientName || !projectDetails) {
        alert('Por favor completa tu nombre y la descripción del proyecto.')
        return
      }

      const message = [
        `Hola Lautaro, te contacto desde la página de servicios:`,
        `- Nombre/Empresa: ${clientName}`,
        clientEmail ? `- Correo: ${clientEmail}` : '',
        `- Tipo de Proyecto: ${projectType}`,
        `- Presupuesto Estimado: ${projectBudget}`,
        `- Detalle del requerimiento: ${projectDetails}`,
      ]
        .filter(Boolean)
        .join('\n')

      const waUrl = `https://wa.me/541130111503?text=${encodeURIComponent(message)}`
      window.open(waUrl, '_blank', 'noopener,noreferrer')
    })
  }

  if (submitBtn && !isReducedMotion) {
    const xTo = gsap.quickTo(submitBtn, 'x', { duration: 0.35, ease: 'power3.out' })
    const yTo = gsap.quickTo(submitBtn, 'y', { duration: 0.35, ease: 'power3.out' })

    submitBtn.addEventListener('mousemove', (e: MouseEvent) => {
      const rect = submitBtn.getBoundingClientRect()
      const centerX = rect.left + rect.width / 2
      const centerY = rect.top + rect.height / 2
      const deltaX = (e.clientX - centerX) * 0.25
      const deltaY = (e.clientY - centerY) * 0.25
      xTo(deltaX)
      yTo(deltaY)
    })

    submitBtn.addEventListener('mouseleave', () => {
      xTo(0)
      yTo(0)
    })
  }

  if (!isReducedMotion) {
    gsap.fromTo(
      '.contact-header > *',
      { opacity: 0, y: 30 },
      {
        opacity: 1,
        y: 0,
        duration: 0.85,
        stagger: 0.12,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '.contact-header',
          start: 'top 85%',
          toggleActions: 'play none none none',
        },
      }
    )

    gsap.fromTo(
      '.form-card',
      { opacity: 0, y: 35 },
      {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '.form-card',
          start: 'top 82%',
          toggleActions: 'play none none none',
        },
      }
    )

    gsap.fromTo(
      '.contact-channels-sidebar',
      { opacity: 0, y: 35 },
      {
        opacity: 1,
        y: 0,
        duration: 0.8,
        delay: 0.1,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '.contact-channels-sidebar',
          start: 'top 82%',
          toggleActions: 'play none none none',
        },
      }
    )
  }
</script>

<style>
  .services-contact-section {
    position: relative;
    width: 100%;
    background-color: var(--bg-primary);
    padding: clamp(5.5rem, 11vh, 9rem) 2rem clamp(6.5rem, 13vh, 10rem);
    border-top: 1px solid var(--border-subtle);
  }

  .services-contact-container {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
  }

  .contact-header {
    margin-bottom: clamp(3.5rem, 6vw, 5rem);
    max-width: 820px;
  }

  .contact-tag {
    display: block;
    margin-bottom: 1.25rem;
  }

  .section-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .contact-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
  }

  .contact-desc {
    font-family: var(--font-sans);
    font-size: clamp(0.98rem, 1.2vw, 1.15rem);
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 62ch;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 1.3fr 0.9fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
  }

  .form-card {
    background: rgba(255, 255, 255, 0.015);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: clamp(2rem, 4vw, 3rem);
    backdrop-filter: blur(8px);
  }

  .intake-form {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .form-row--two {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .form-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 0.85rem 1rem;
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 14px;
    transition: all 0.25s ease;
    outline: none;
  }

  .form-select {
    font-family: var(--font-mono);
    font-size: 12px;
    background-color: #121212;
    cursor: pointer;
  }

  .form-select option {
    background-color: #121212;
    color: var(--text-primary);
  }

  .form-textarea {
    resize: vertical;
    min-height: 110px;
    line-height: 1.6;
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.05);
    box-shadow: 0 0 16px rgba(255, 255, 255, 0.06);
  }

  .form-input::placeholder,
  .form-textarea::placeholder {
    color: rgba(255, 255, 255, 0.25);
  }

  .form-action-area {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding-top: 0.75rem;
  }

  .magnetic-submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.05rem 2rem;
    background: #ffffff;
    color: #000000;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    border: 1px solid #ffffff;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.25s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
    width: 100%;
  }

  .magnetic-submit-btn:hover {
    background: #e5e5e5;
    box-shadow: 0 6px 24px rgba(255, 255, 255, 0.18);
  }

  .btn-arrow {
    font-size: 14px;
    transition: transform 0.2s ease;
  }

  .magnetic-submit-btn:hover .btn-arrow {
    transform: translate(2px, -2px);
  }

  .form-notice {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    text-align: center;
  }

  .contact-channels-sidebar {
    width: 100%;
  }

  .sidebar-box {
    background: rgba(255, 255, 255, 0.015);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: clamp(1.75rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    gap: 2rem;
    backdrop-filter: blur(8px);
  }

  .sidebar-box__header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .box-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #22c55e;
    box-shadow: 0 0 10px rgba(34, 197, 94, 0.6);
  }

  .box-heading {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .direct-channels-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .direct-channel-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .direct-channel-item--highlight {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0.01) 100%);
    border-color: rgba(255, 255, 255, 0.14);
  }

  .direct-channel-item:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }

  .channel-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .channel-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .channel-val {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-primary);
    font-weight: 500;
  }

  .channel-sub {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--text-secondary);
  }

  .channel-arrow {
    font-size: 16px;
    color: var(--text-muted);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .direct-channel-item:hover .channel-arrow {
    transform: translate(2px, -2px);
    color: var(--text-primary);
  }

  .sidebar-guarantees {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .guarantee-heading {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .guarantee-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .guarantee-item {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.45;
    color: var(--text-secondary);
  }

  .guarantee-dash {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
  }

  @media (max-width: 1024px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 768px) {
    .services-contact-section {
      padding: 4rem 1.25rem 5rem;
    }

    .form-card {
      padding: 1.5rem;
    }

    .form-row--two {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .contact-header {
      margin-bottom: 2.5rem;
    }

    .contact-title {
      font-size: clamp(1.85rem, 7.5vw, 2.5rem);
    }
  }
</style>
