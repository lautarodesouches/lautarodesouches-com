---
import { Globe, Layers, Zap, ArrowRight } from 'lucide-astro'
import SectionTitle from '../../../shared/components/SectionTitle.astro'
import Badge from '../../../shared/components/Badge.astro'
import styles from '../styles/Services.module.css'
import { servicesData } from '../data/services.data'
---

<section class={styles.services} id="soluciones">
  <div class="container">
    <SectionTitle
      eyebrow="Para Empresas & Negocios"
      title="Soluciones Web Enfocadas en Resultados Comerciales"
      description="Construyo plataformas digitales sin plantillas genéricas. Cada proyecto se diseña para responder rápido, posicionar en Google y resolver fricciones operativas reales."
    />

    <div class={styles.services__grid}>
      {servicesData.map((service) => (
        <article class={styles.services__card} data-service-card>
          <div>
            <div class={styles['services__card-header']}>
              <div class={styles['services__top-row']}>
                <div class={styles['services__icon-wrap']}>
                  {service.iconName === 'Globe' && <Globe size={20} />}
                  {service.iconName === 'Layers' && <Layers size={20} />}
                  {service.iconName === 'Zap' && <Zap size={20} />}
                </div>
                <Badge variant="primary" size="sm">
                  {service.badge}
                </Badge>
              </div>

              <h3 class={styles['services__card-title']}>{service.title}</h3>
              <p class={styles['services__card-summary']}>{service.summary}</p>
            </div>

            <div class={styles.services__deliverables}>
              {service.deliverables.map((item) => (
                <div class={styles['services__deliverable-item']}>
                  <span class={styles['services__deliverable-bullet']} />
                  <span>{item}</span>
                </div>
              ))}
            </div>
          </div>

          <div class={styles['services__impact-box']}>
            <span class={styles['services__impact-label']}>Impacto comercial esperado:</span>
            <span class={styles['services__impact-text']}>{service.clientImpact}</span>
          </div>
        </article>
      ))}
    </div>

    <div class={styles['services__cta-banner']} data-service-banner>
      <div class={styles['services__cta-content']}>
        <h4 class={styles['services__cta-title']}>¿Tienes una idea o proyecto web en mente?</h4>
        <p class={styles['services__cta-description']}>
          Analicemos la arquitectura adecuada y los plazos de entrega sin compromiso. Comunicación directa de desarrollador a cliente.
        </p>
      </div>
      <a
        href="https://wa.me/541130111503?text=Hola%20Lautaro,%20estoy%20interesado%20en%20cotizar%20un%20proyecto%20web%20para%20mi%20empresa"
        target="_blank"
        rel="noopener noreferrer"
        class={styles['services__cta-button']}
      >
        <span>Cotizar proyecto</span>
        <ArrowRight size={16} />
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const serviceCards = document.querySelectorAll('[data-service-card]')
  const serviceBanner = document.querySelector('[data-service-banner]')

  if (serviceCards.length > 0) {
    gsap.from(serviceCards, {
      scrollTrigger: {
        trigger: '#soluciones',
        start: 'top 80%',
      },
      opacity: 0,
      y: 25,
      duration: 0.8,
      stagger: 0.12,
      ease: 'power4.out',
    })
  }

  if (serviceBanner) {
    gsap.from(serviceBanner, {
      scrollTrigger: {
        trigger: serviceBanner,
        start: 'top 85%',
      },
      opacity: 0,
      y: 20,
      duration: 0.8,
      ease: 'power4.out',
    })
  }
</script>
