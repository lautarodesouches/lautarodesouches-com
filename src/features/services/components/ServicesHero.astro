---
import { servicesTelemetry } from '../data/services.data'
---

<section class="services-hero-section" id="hero-servicios" aria-labelledby="services-hero-title">
  <div class="services-hero-container">
    <div class="services-hero-grid">
      <div class="services-hero-content">
        <div class="services-hero-tag">
          <span class="section-tag">01 // SERVICIOS & INGENIERÍA A MEDIDA</span>
        </div>

        <h1 class="services-hero-title" id="services-hero-title">
          Desarrollo de software y sitios web desde cero. Sin intermediarios.
        </h1>

        <p class="services-hero-desc">
          Trabajo directamente con directores, fundadores y equipos para construir plataformas web de alto rendimiento, código limpio y resultados de negocio tangibles.
        </p>

        <div class="services-hero-actions">
          <a href="#catalogo" class="btn-action btn-action--primary">
            <span>Explorar Catálogo de Servicios</span>
            <span class="btn-arrow" aria-hidden="true">↓</span>
          </a>
          <a href="#contacto" class="btn-action btn-action--secondary">
            <span>Iniciar Consulta Directa</span>
            <span class="btn-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="services-hero-telemetry">
        <div class="telemetry-frame">
          <div class="telemetry-frame__top">
            <div class="telemetry-status">
              <span class="status-label">CONDICIONES OPERATIVAS B2B</span>
            </div>
            <span class="telemetry-id">[ SLA VERIFICADO ]</span>
          </div>

          <div class="telemetry-frame__metrics">
            <div class="telemetry-metric">
              <span class="metric-label">[ DISPONIBILIDAD ]</span>
              <div class="metric-value-row">
                <span class="status-pulse-dot" aria-hidden="true"></span>
                <span class="metric-value metric-value--highlight">{servicesTelemetry.status}</span>
              </div>
            </div>

            <div class="telemetry-metric">
              <span class="metric-label">[ MODELO DE TRABAJO ]</span>
              <span class="metric-value">{servicesTelemetry.model}</span>
            </div>

            <div class="telemetry-metric">
              <span class="metric-label">[ TIEMPO DE RESPUESTA ]</span>
              <span class="metric-value metric-value--mono">{servicesTelemetry.responseLatency}</span>
            </div>

            <div class="telemetry-metric">
              <span class="metric-label">[ PROPIEDAD INTELECTUAL ]</span>
              <span class="metric-value">{servicesTelemetry.ipOwnership}</span>
            </div>
          </div>

          <div class="telemetry-frame__footer">
            <span class="footer-note">// FACTURACIÓN DIRECTA & CONTRATO DE SERVICIOS PROFESIONALES</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap'

  const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  if (!isReducedMotion) {
    gsap.fromTo(
      '.services-hero-content > *',
      { opacity: 0, y: 25 },
      {
        opacity: 1,
        y: 0,
        duration: 0.9,
        stagger: 0.1,
        ease: 'power3.out',
      }
    )

    gsap.fromTo(
      '.services-hero-telemetry',
      { opacity: 0, y: 35 },
      {
        opacity: 1,
        y: 0,
        duration: 1,
        delay: 0.2,
        ease: 'power3.out',
      }
    )
  }
</script>

<style>
  .services-hero-section {
    position: relative;
    width: 100%;
    min-height: 85vh;
    display: flex;
    align-items: center;
    background-color: var(--bg-primary);
    padding: calc(var(--header-height, 80px) + 5rem) 2rem 5rem;
    overflow: hidden;
  }

  .services-hero-container {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
  }

  .services-hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: center;
  }

  .services-hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .services-hero-tag {
    display: block;
  }

  .section-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .services-hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5.2vw, 4.4rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .services-hero-desc {
    font-family: var(--font-sans);
    font-size: clamp(15px, 1.35vw, 18px);
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 58ch;
  }

  .services-hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .btn-action {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.9rem 1.6rem;
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    line-height: 1;
  }

  .btn-action--primary {
    background-color: #ffffff;
    color: #000000;
    font-weight: 600;
    border: 1px solid #ffffff;
  }

  .btn-action--primary:hover {
    background-color: #e5e5e5;
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(255, 255, 255, 0.15);
  }

  .btn-action--secondary {
    background-color: rgba(255, 255, 255, 0.03);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
  }

  .btn-action--secondary:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }

  .btn-arrow {
    font-size: 13px;
    transition: transform 0.2s ease;
  }

  .btn-action:hover .btn-arrow {
    transform: translate(2px, -2px);
  }

  .services-hero-telemetry {
    width: 100%;
  }

  .telemetry-frame {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    backdrop-filter: blur(10px);
    position: relative;
  }

  .telemetry-frame::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 14px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
    pointer-events: none;
  }

  .telemetry-frame__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    flex-wrap: wrap;
  }

  .telemetry-status {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .status-pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #22c55e;
    box-shadow: 0 0 10px rgba(34, 197, 94, 0.6);
    animation: status-pulse 2.2s infinite ease-in-out;
  }

  @keyframes status-pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(0.85);
    }
  }

  .status-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .telemetry-id {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
  }

  .telemetry-frame__metrics {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  .telemetry-metric {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .metric-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .metric-value-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .metric-value {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .metric-value--highlight {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    color: #4ade80;
    letter-spacing: 0.02em;
  }

  .metric-value--mono {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-primary);
  }

  .telemetry-frame__footer {
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .footer-note {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  @media (max-width: 1024px) {
    .services-hero-grid {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .services-hero-section {
      padding: calc(var(--header-height, 80px) + 3rem) 1.5rem 4rem;
    }
  }

  @media (max-width: 768px) {
    .services-hero-section {
      padding: 6.5rem 1rem 3.5rem;
    }

    .services-hero-title {
      font-size: clamp(2rem, 8.5vw, 2.75rem);
    }

    .services-hero-desc {
      font-size: 14px;
    }

    .btn-action {
      width: 100%;
      justify-content: center;
    }

    .telemetry-frame {
      padding: 1.5rem;
    }
  }
</style>
