---
import '../styles/global.css'
import type { ThemePalette } from '../data/palettes'

interface Props {
  title?: string
  description?: string
  palette?: ThemePalette
}

const {
  title = 'Lautaro Desouches — Lead Frontend Architect & Full Stack Engineer',
  description = 'Portfolio profesional de Lautaro Desouches. Especialista en Arquitectura Web, Astro, Next.js y Sistemas Full Stack.',
  palette,
} = Astro.props

const paletteStyle = palette
  ? `
  --bg-primary: ${palette.tokens.bgPrimary};
  --bg-surface: ${palette.tokens.bgSurface};
  --bg-surface-elevated: ${palette.tokens.bgSurfaceElevated};
  --border-subtle: ${palette.tokens.borderSubtle};
  --border-focus: ${palette.tokens.borderFocus};
  --text-primary: ${palette.tokens.textPrimary};
  --text-secondary: ${palette.tokens.textSecondary};
  --text-muted: ${palette.tokens.textMuted};
  --accent-cyan: ${palette.tokens.accentPrimary};
  --accent-glow: ${palette.tokens.accentGlow};
`
  : undefined
---

<!doctype html>
<html lang="es" style={paletteStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link
      rel="preload"
      href="/fonts/clash-display-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/general-sans-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/general-sans-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <slot />

    <script>
      import Lenis from 'lenis'
      import { gsap } from 'gsap'
      import { ScrollTrigger } from 'gsap/ScrollTrigger'

      gsap.registerPlugin(ScrollTrigger)

      const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      if (!isReducedMotion) {
        const lenis = new Lenis({
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        })

        lenis.on('scroll', ScrollTrigger.update)

        gsap.ticker.add((time) => {
          lenis.raf(time * 1000)
        })

        gsap.ticker.lagSmoothing(0)
      }
    </script>
  </body>
</html>
