---
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  image?: string
}

const {
  title = 'Lautaro Desouches — Desarrollador Web Full Stack',
  description = 'Portfolio profesional de Lautaro Desouches. Especialista en Arquitectura Web, Astro, Next.js y Sistemas Full Stack.',
  image = '/og-image.png',
} = Astro.props

const siteUrl = Astro.site ?? new URL('https://lautarodesouches.com')
const canonicalURL = new URL(Astro.url.pathname, siteUrl)
const ogImageURL = new URL(image, siteUrl)

const schemaOrgData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://lautarodesouches.com/#person',
      name: 'Lautaro Desouches',
      jobTitle: 'Desarrollador Web Full Stack',
      url: 'https://lautarodesouches.com',
      image: ogImageURL.toString(),
      sameAs: [
        'https://linkedin.com/in/lautarodesouches',
        'https://github.com/lautarodesouches',
      ],
      email: 'mailto:lautarodesouches@outlook.com',
      telephone: '+541130111503',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Ramos Mejía',
        addressRegion: 'Buenos Aires',
        addressCountry: 'AR',
      },
      alumniOf: {
        '@type': 'EducationalOrganization',
        name: 'Universidad Nacional de La Matanza',
      },
      knowsAbout: [
        'TypeScript',
        'React',
        'Next.js',
        'Node.js',
        'NestJS',
        'Java',
        'Spring Boot',
        'Astro',
        'PostgreSQL',
        'Prisma ORM',
        'Docker',
        'CI/CD',
        'Playwright',
        'Vitest',
        'Core Web Vitals',
        'Clean Architecture',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://lautarodesouches.com/#website',
      url: 'https://lautarodesouches.com',
      name: 'Lautaro Desouches',
      description: description,
      inLanguage: 'es-AR',
      publisher: {
        '@id': 'https://lautarodesouches.com/#person',
      },
    },
    {
      '@type': 'ProfilePage',
      '@id': 'https://lautarodesouches.com/#profilepage',
      url: canonicalURL.toString(),
      name: title,
      isPartOf: {
        '@id': 'https://lautarodesouches.com/#website',
      },
      about: {
        '@id': 'https://lautarodesouches.com/#person',
      },
      mainEntity: {
        '@id': 'https://lautarodesouches.com/#person',
      },
      inLanguage: 'es-AR',
    },
  ],
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="bingbot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <meta name="author" content="Lautaro Desouches" />
    <meta name="generator" content={Astro.generator} />
    <meta name="keywords" content="Lautaro Desouches, Desarrollador Web Full Stack, React, Next.js, TypeScript, Node.js, NestJS, Java Spring Boot, Astro, Buenos Aires, Argentina" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="Lautaro Desouches" />
    <meta property="og:locale" content="es_AR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="twitter:creator" content="@lautarodesouches" />

    <meta name="theme-color" content="#0A0A0A" />
    <meta name="color-scheme" content="dark" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Lautaro Desouches" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <script type="application/ld+json" set:html={JSON.stringify(schemaOrgData)} />
    <link
      rel="preload"
      href="/fonts/clash-display-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/general-sans-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/general-sans-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <style is:inline>
      :root {
        --bg-primary: #0A0A0A;
        --bg-surface: #121212;
        --text-primary: #FFFFFF;
        --text-secondary: #A3A3A3;
        --font-display: 'Clash Display', -apple-system, BlinkMacSystemFont, sans-serif;
        --font-sans: 'General Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
      }
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      html {
        background-color: #0A0A0A;
        color: #FFFFFF;
        overflow-x: clip;
      }
      body {
        min-height: 100vh;
        background-color: #0A0A0A;
        color: #FFFFFF;
        font-family: var(--font-sans);
        overflow-x: clip;
      }
      .hero-container {
        min-height: 100vh;
        background-color: #0A0A0A;
        position: relative;
      }
    </style>
  </head>
  <body>
    <div class="ambient-torch" id="ambient-torch" aria-hidden="true"></div>
    <a href="#main" class="skip-to-content">Saltar al contenido principal</a>
    <slot />

    <script>
      import Lenis from 'lenis'
      import { gsap } from 'gsap'
      import { ScrollTrigger } from 'gsap/ScrollTrigger'

      gsap.registerPlugin(ScrollTrigger)

      const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      const hasFinePointer = window.matchMedia('(pointer: fine)').matches
      const torch = document.getElementById('ambient-torch')

      if (torch && hasFinePointer && !isReducedMotion) {
        const setTorchX = gsap.quickTo(torch, 'x', { duration: 0.35, ease: 'power3.out' })
        const setTorchY = gsap.quickTo(torch, 'y', { duration: 0.35, ease: 'power3.out' })

        window.addEventListener('mousemove', (e: MouseEvent) => {
          setTorchX(e.clientX)
          setTorchY(e.clientY)
          if (torch.style.opacity !== '1') {
            torch.style.opacity = '1'
          }
        })

        document.addEventListener('mouseleave', () => {
          torch.style.opacity = '0'
        })
      }

      interface WindowWithLenis extends Window {
        __lenis?: Lenis
      }

      let lenis: Lenis | undefined

      if (!isReducedMotion) {
        lenis = new Lenis({
          lerp: 0.075,
          wheelMultiplier: 0.95,
          touchMultiplier: 1.2,
          smoothWheel: true,
        })

        ;(window as unknown as WindowWithLenis).__lenis = lenis

        lenis.on('scroll', ScrollTrigger.update)

        gsap.ticker.add((time) => {
          lenis?.raf(time * 1000)
        })

        gsap.ticker.lagSmoothing(0)
      }

      document.addEventListener('click', (event: MouseEvent) => {
        if (
          event.defaultPrevented ||
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) {
          return
        }

        const anchor = (event.target as HTMLElement).closest('a') as HTMLAnchorElement | null
        if (!anchor) return

        const href = anchor.getAttribute('href')
        if (!href) return

        const isSamePageHash =
          href.startsWith('#') ||
          (Boolean(anchor.hash) && (anchor.pathname === window.location.pathname || anchor.pathname === ''))

        if (!isSamePageHash) return

        const hash = anchor.hash || (href.startsWith('#') ? href : '')
        if (!hash || hash === '#' || hash === '#!') return

        const target = document.querySelector(hash) as HTMLElement | null
        if (!target) return

        event.preventDefault()

        if (lenis && !isReducedMotion) {
          lenis.scrollTo(target, { duration: 1.2 })
        } else {
          target.scrollIntoView({ behavior: isReducedMotion ? 'auto' : 'smooth' })
        }

        history.pushState(null, '', hash)
      })
    </script>
  </body>
</html>
