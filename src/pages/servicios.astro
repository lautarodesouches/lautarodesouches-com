---

<BaseLayout
  title="Servicios Web | Lautaro Desouches"
  description="Desarrollo soluciones digitales a medida: sitios corporativos, e-commerce, automatizaciones y apps móviles. Velocidad 100/100, SEO técnico y trato directo."
>
  <main class="min-h-screen bg-surface text-foreground antialiased overflow-x-hidden">

    <!-- HERO -->
    <section class="relative min-h-screen flex flex-col justify-center px-6 pt-28 pb-20 overflow-hidden bg-surface border-b border-surface-border">
      <div aria-hidden class="pointer-events-none absolute inset-0 [background:radial-gradient(ellipse_80%_60%_at_50%_-10%,rgba(99,102,241,0.08)_0%,transparent_70%)] dark:[background:radial-gradient(ellipse_80%_60%_at_50%_-10%,rgba(45,212,191,0.1)_0%,transparent_70%)]"></div>
      <div aria-hidden class="pointer-events-none absolute inset-0 opacity-[0.03] dark:opacity-[0.04]" style="background-image: linear-gradient(rgba(0,0,0,1) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,1) 1px, transparent 1px); background-size: 48px 48px;"></div>

      <div class="relative z-10 max-w-5xl mx-auto w-full">
        <div class="hero-item mb-8" style="--delay: 0s">
          <Eyebrow>
            <span class="relative flex h-1.5 w-1.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75 bg-indigo-500 dark:bg-teal-400"></span>
              <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-indigo-600 dark:bg-teal-400"></span>
            </span>
            Disponible para nuevos proyectos
          </Eyebrow>
        </div>

        <h1 class="hero-item text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black tracking-tighter leading-[0.95] mb-8 text-slate-900 dark:text-white" style="--delay: 0.1s">
          Transformá la{' '}
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand to-tech dark:from-teal-400 dark:to-cyan-400">tecnología</span>
          <br />
          de tu empresa en{' '}
          <span class="italic text-slate-600 dark:text-zinc-300">resultados reales.</span>
        </h1>

        <p class="hero-item max-w-2xl text-lg md:text-xl leading-relaxed mb-12 text-slate-600 dark:text-zinc-400" style="--delay: 0.22s">
          Desarrollo soluciones digitales a medida para constructoras, inmobiliarias, estudios, comercios
          y distribuidoras. Sin tecnicismos. Sin intermediarios. Con resultados medibles desde el primer día.
        </p>

        <div class="hero-item flex flex-wrap gap-4" style="--delay: 0.35s">
          <ButtonPrimary href={WHATSAPP_URL}>
            <Fragment set:html={serviceIcons.whatsapp} />
            Hablemos de tu proyecto
          </ButtonPrimary>
          <ButtonGhost href="#servicios">
            Ver mis servicios
            <Fragment set:html={serviceIcons.arrowRight} />
          </ButtonGhost>
        </div>

        <div class="hero-item mt-20 flex flex-wrap items-center gap-x-8 gap-y-3 text-sm text-slate-400 dark:text-zinc-500" style="--delay: 0.55s">
          {['+5 años de experiencia', 'Trato directo sin intermediarios', 'Proyectos llave en mano', 'Velocidad 100/100 garantizada'].map((item) => (
            <span class="flex items-center gap-2">
              <span class="text-tech dark:text-teal-500"><Fragment set:html={serviceIcons.check} /></span>
              {item}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- DIAGNÓSTICO -->
    <section id="diagnostico" class="py-24 px-6 bg-white dark:bg-black">
      <div class="max-w-5xl mx-auto">
        <FadeUp>
          <div class="text-center mb-16 space-y-4">
            <Eyebrow>Diagnóstico</Eyebrow>
            <h2 class="text-4xl md:text-5xl font-black tracking-tighter text-slate-900 dark:text-white">
              ¿Te suena familiar alguno de estos?
            </h2>
            <p class="max-w-xl mx-auto leading-relaxed text-slate-500 dark:text-zinc-400">
              Trabajé con decenas de negocios con los mismos problemas. Todos tienen solución concreta.
            </p>
          </div>
        </FadeUp>

        <div class="grid md:grid-cols-2 gap-6">
          <FadeUp class="flex flex-col">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-8 h-8 rounded-full flex items-center justify-center bg-red-100 border border-red-200 dark:bg-red-500/10 dark:border-red-500/20 text-red-500 dark:text-red-400">
                <Fragment set:html={serviceIcons.xmark} />
              </div>
              <span class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-zinc-400">El problema actual</span>
            </div>
            <ul class="flex flex-col gap-3 flex-1">
              {painPoints.map((item) => (
                <li class="flex items-center gap-4 px-5 py-4 rounded-xl text-sm bg-red-50 border border-red-100 text-slate-700 dark:bg-red-950/20 dark:border-red-500/10 dark:text-zinc-300">
                  <span class="text-red-400 shrink-0"><Fragment set:html={serviceIcons.xmark} /></span>
                  {item.problem}
                </li>
              ))}
            </ul>
          </FadeUp>

          <FadeUp class="flex flex-col">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-8 h-8 rounded-full flex items-center justify-center bg-emerald-100 border border-emerald-200 dark:bg-teal-500/10 dark:border-teal-500/20 text-emerald-600 dark:text-teal-400">
                <Fragment set:html={serviceIcons.check} />
              </div>
              <span class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-zinc-400">Lo que entrego</span>
            </div>
            <ul class="flex flex-col gap-3 flex-1">
              {painPoints.map((item) => (
                <li class="flex items-center gap-4 px-5 py-4 rounded-xl text-sm font-medium bg-emerald-50 border border-emerald-100 text-slate-800 dark:bg-teal-950/20 dark:border-teal-500/10 dark:text-zinc-200">
                  <span class="text-emerald-500 dark:text-teal-400 shrink-0"><Fragment set:html={serviceIcons.check} /></span>
                  {item.solution}
                </li>
              ))}
            </ul>
          </FadeUp>
        </div>

        <div class="mt-12 text-center">
          <FadeUp>
            <ButtonPrimary href={WHATSAPP_URL}>
              <Fragment set:html={serviceIcons.whatsapp} />
              Quiero resolver estos problemas
            </ButtonPrimary>
          </FadeUp>
        </div>
      </div>
    </section>

    <!-- SERVICIOS GRID -->
    <section id="servicios" class="py-24 px-6 relative bg-slate-50 dark:bg-zinc-950">
      <div aria-hidden class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 w-px h-24 bg-gradient-to-b from-transparent via-brand/30 to-transparent dark:via-teal-500/30"></div>

      <div class="max-w-6xl mx-auto">
        <FadeUp class="text-center mb-16 space-y-4">
          <Eyebrow>Servicios</Eyebrow>
          <h2 class="text-4xl md:text-5xl font-black tracking-tighter text-slate-900 dark:text-white">
            Lo que hago, en resultados concretos
          </h2>
          <p class="max-w-xl mx-auto leading-relaxed text-slate-500 dark:text-zinc-400">
            Sin tecnicismos. Cada servicio está diseñado para resolver un problema real y generar retorno tangible.
          </p>
        </FadeUp>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
          {services.slice(0, 2).map((service) => (
            <FadeUp class="md:col-span-6">
              <div class="h-full flex flex-col p-7 rounded-2xl group cursor-default transition-all hover:-translate-y-1.5 bg-white border border-slate-200 hover:border-brand/30 dark:bg-zinc-900 dark:border-zinc-800 dark:hover:border-teal-500/25">
                <div class="flex items-center gap-3 mb-5">
                  <div class="w-10 h-10 rounded-xl flex items-center justify-center transition-colors bg-indigo-50 border border-indigo-100 text-brand group-hover:bg-indigo-100 dark:bg-teal-500/10 dark:border-teal-500/20 dark:text-teal-400 dark:group-hover:bg-teal-500/15">
                    <Fragment set:html={serviceIcons[service.iconKey]} />
                  </div>
                  <span class="text-xs font-semibold uppercase tracking-widest text-brand/70 dark:text-teal-400/80">{service.eyebrow}</span>
                </div>
                <h3 class="text-xl font-bold mb-3 leading-snug transition-colors text-slate-900 group-hover:text-brand dark:text-white dark:group-hover:text-teal-100">{service.title}</h3>
                <p class="text-sm leading-relaxed mb-6 flex-grow text-slate-500 dark:text-zinc-400">{service.description}</p>
                <ul class="space-y-2">
                  {service.highlights.map((h) => (
                    <li class="flex items-center gap-2 text-xs text-slate-500 dark:text-zinc-400">
                      <span class="text-tech dark:text-teal-500"><Fragment set:html={serviceIcons.check} /></span>
                      {h}
                    </li>
                  ))}
                </ul>
                <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="group mt-5 inline-flex items-center gap-1.5 text-xs font-medium transition-colors text-slate-300 group-hover:text-brand dark:text-zinc-600 dark:group-hover:text-teal-400">
