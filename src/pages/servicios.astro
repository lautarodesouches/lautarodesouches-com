---
import BaseLayout from '../layouts/BaseLayout.astro'
import FadeUp from '../features/servicios/components/FadeUp.astro'
import Eyebrow from '../features/servicios/components/Eyebrow.astro'
import ButtonPrimary from '../features/servicios/components/ButtonPrimary.astro'
import ButtonGhost from '../features/servicios/components/ButtonGhost.astro'
import ThemeToggle from '../shared/components/ThemeToggle.astro'
import { services, painPoints, trustItems } from '../features/servicios/data/servicios.data'
import { WHATSAPP_URL, EMAIL, MAILTO } from '../features/servicios/constants/contact'
import type { ServiceCard, TrustItem } from '../features/servicios/types/servicios.types'
import '../styles/globals.css'

const serviceIcons: Record<string, string> = {
