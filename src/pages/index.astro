---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../features/home/components/Hero.astro'
import About from '../features/home/components/About.astro'
import Projects from '../features/home/components/Projects'
import Skills from '../features/home/components/Skills.astro'
import Contact from '../features/home/components/Contact.astro'
import ThemeToggle from '../shared/components/ThemeToggle.astro'
import '../styles/globals.css'
---

<BaseLayout>
  <main class="min-h-screen bg-white dark:bg-black">
    <Hero />
    <About />
    <Projects client:visible />
    <Skills />
    <Contact />
  </main>
  <ThemeToggle />
</BaseLayout>
