---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Hero from '../features/hero/components/Hero.astro'
import Solutions from '../features/solutions/components/Solutions.astro'
import Projects from '../features/projects/components/Projects.astro'
import Trajectory from '../features/trajectory/components/Trajectory.astro'
import Contact from '../features/contact/components/Contact.astro'
import Footer from '../components/Footer.astro'
import IntroIris from '../shared/components/IntroIris.astro'
---

<BaseLayout>
  <IntroIris />
  <Header />
  <main id="main" tabindex="-1">
    <Hero />
    <Solutions />
    <Projects />
    <Trajectory />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
