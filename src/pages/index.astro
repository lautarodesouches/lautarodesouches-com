---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout>
  <main class="diagnostic-page">
    <section class="diagnostic-viewport">
      <div class="diagnostic-card diagnostic-hero">
        <span class="diagnostic-badge">System Status // Core Initialized</span>
        <h1 class="diagnostic-title">Lautaro Desouches</h1>
        <p class="diagnostic-subtitle">
          Senior Frontend Engineer & Full Stack Specialist. Arquitectura de alto rendimiento, micro-animaciones fluidas con Lenis y orquestación reactiva con GSAP ScrollTrigger.
        </p>
        <div class="diagnostic-telemetry">
          <code>[01 // TELEMETRY] clash-display + general-sans + jetbrains-mono [ACTIVE]</code>
        </div>
      </div>
    </section>

    <section class="diagnostic-viewport diagnostic-viewport--scroll">
      <div class="diagnostic-card diagnostic-scroll-trigger">
        <span class="diagnostic-badge">ScrollTrigger Audit</span>
        <h2 class="diagnostic-section-title">Lenis & GSAP Synchronized</h2>
        <p class="diagnostic-subtitle">
          Smooth scroll con inercia física de 1.2s sincronizado al ticker de GSAP. Sin saltos de layout, sin errores de hidratación y con respeto estricto a prefers-reduced-motion.
        </p>
        <div class="diagnostic-telemetry">
          <code>[02 // TICKER] lenis.raf connected to gsap.ticker [OK]</code>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  gsap.from('.diagnostic-hero', {
    opacity: 0,
    y: 28,
    duration: 0.9,
    ease: 'power3.out',
  })

  gsap.from('.diagnostic-scroll-trigger', {
    scrollTrigger: {
      trigger: '.diagnostic-scroll-trigger',
      start: 'top 85%',
      toggleActions: 'play none none reverse',
    },
    opacity: 0,
    y: 36,
    duration: 0.8,
    ease: 'power3.out',
  })
</script>

<style>
  .diagnostic-page {
    min-height: 200vh;
    display: flex;
    flex-direction: column;
  }

  .diagnostic-viewport {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .diagnostic-viewport--scroll {
    background: radial-gradient(
      ellipse 60% 40% at 50% 50%,
      var(--accent-glow) 0%,
      transparent 70%
    );
  }

  .diagnostic-card {
    max-width: 720px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2.75rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.7);
  }

  .diagnostic-badge {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--accent-cyan);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .diagnostic-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--text-primary);
  }

  .diagnostic-section-title {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 4.5vw, 2.75rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .diagnostic-subtitle {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .diagnostic-telemetry {
    padding: 1rem 1.25rem;
    border-radius: 10px;
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent-cyan);
  }
</style>
