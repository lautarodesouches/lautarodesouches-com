---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from '../../components/Header.astro'
import Hero from '../../components/Hero.astro'
import ThemeSwitcherBadge from '../../components/ThemeSwitcherBadge.astro'
import { palettes } from '../../data/palettes'

export function getStaticPaths() {
  return Object.keys(palettes).map((id) => ({
    params: { id },
    props: { palette: palettes[id] },
  }))
}

const { palette } = Astro.props
---

<BaseLayout title={`Lautaro Desouches — [Variante ${palette.id}: ${palette.name}]`} palette={palette}>
  <Header />
  <main>
    <Hero />
  </main>
  <ThemeSwitcherBadge activeId={palette.id} />
</BaseLayout>

