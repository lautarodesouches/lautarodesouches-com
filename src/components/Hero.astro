---
import HeroCanvas from './hero/HeroCanvas.astro'
---

<section class="hero-container" id="hero">
  <div class="hero-centerpiece" aria-hidden="true">
    <HeroCanvas />
  </div>

  <div class="hero-framing">
    <div class="hero-frame-block hero-frame-block--solutions">
      <div class="reveal-wrapper">
        <span class="frame-index reveal-line">
          <span class="frame-index-desktop">01 // EMPRESAS & NEGOCIOS</span>
          <span class="frame-index-mobile">02 // SOLUCIONES</span>
        </span>
      </div>
      <div class="reveal-wrapper">
        <h2 class="frame-title frame-title--solutions reveal-line">
          <span class="frame-title-desktop">Sitios web y sistemas a medida de punta a punta.</span>
          <span class="frame-title-mobile">Sitios y plataformas web a medida.</span>
        </h2>
      </div>
      <div class="reveal-wrapper">
        <p class="frame-desc reveal-line">
          <span class="frame-desc-desktop">Desarrollo desde cero para pequeñas y grandes empresas: desde presencias corporativas de alta conversión hasta plataformas empresariales complejas.</span>
          <span class="frame-desc-mobile">Desarrollo de punta a punta: desde webs de alta velocidad hasta plataformas complejas.</span>
        </p>
      </div>
    </div>

    <div class="hero-frame-block hero-frame-block--role">
      <div class="reveal-wrapper">
        <span class="frame-index reveal-line">
          <span class="frame-index-desktop">02 // INGENIERÍA DE SOFTWARE</span>
          <span class="frame-index-mobile">01 // INGENIERÍA</span>
        </span>
      </div>
      <div class="reveal-wrapper">
        <h1 class="frame-title frame-title--role reveal-line">Desarrollador Web Full Stack</h1>
      </div>
      <div class="reveal-wrapper frame-desc-wrapper-desktop">
        <p class="frame-desc reveal-line">
          Arquitectura frontend y backend en producción. Interfaces fluidas, APIs resilientes, tipado estricto y rendimiento optimizado.
        </p>
      </div>
      <div class="reveal-wrapper">
        <div class="frame-stack reveal-line">
          TypeScript · React / Next.js · Node · Astro · SQL
        </div>
      </div>
    </div>
  </div>

  <div class="marquee-wrapper" aria-hidden="true">
    <div class="marquee-track">
      <span class="marquee-text">Full Stack Engineering — Software de Alta Precisión — Arquitectura Escalable — Rendimiento Extremo — Interfaces Fluidas — Persistencia Resiliente —&nbsp;</span>
      <span class="marquee-text">Full Stack Engineering — Software de Alta Precisión — Arquitectura Escalable — Rendimiento Extremo — Interfaces Fluidas — Persistencia Resiliente —&nbsp;</span>
      <span class="marquee-text">Full Stack Engineering — Software de Alta Precisión — Arquitectura Escalable — Rendimiento Extremo — Interfaces Fluidas — Persistencia Resiliente —&nbsp;</span>
      <span class="marquee-text">Full Stack Engineering — Software de Alta Precisión — Arquitectura Escalable — Rendimiento Extremo — Interfaces Fluidas — Persistencia Resiliente —&nbsp;</span>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const track = document.querySelector('.marquee-track') as HTMLElement | null

  if (!isReducedMotion && track) {
    let xPercent = 0
    let direction = -1
    const baseSpeed = 0.0045

    ScrollTrigger.create({
      onUpdate: (self) => {
        direction = self.direction === 1 ? -1 : 1
      },
    })

    gsap.ticker.add((_time, deltaTime) => {
      const deltaFactor = Math.min(deltaTime / 16.667, 2)
      xPercent += baseSpeed * direction * deltaFactor
      if (xPercent <= -50) xPercent = 0
      if (xPercent > 0) xPercent = -50
      gsap.set(track, { xPercent })
    })
  }

  if (!isReducedMotion) {
    gsap.fromTo(
      '.reveal-line',
      { yPercent: 100, opacity: 0 },
      {
        yPercent: 0,
        opacity: 1,
        duration: 0.9,
        ease: 'power3.out',
        stagger: 0.08,
      }
    )
  } else {
    gsap.set('.reveal-line', { yPercent: 0, opacity: 1 })
  }
</script>

<style>
  .hero-container {
    position: relative;
    height: 100vh;
    min-height: 640px;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: calc(var(--header-height, 80px) + 1.5rem) 0 0;
    overflow: hidden;
    background-color: var(--bg-primary);
  }

  .hero-centerpiece {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 1;
  }

  .hero-framing {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-inline: clamp(1.5rem, 4vw, 4rem);
    pointer-events: none;
    flex: 1;
    margin-bottom: clamp(4.5rem, 10vh, 8rem);
  }

  .hero-frame-block {
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 360px;
  }

  .hero-frame-block--solutions {
    order: 1;
    margin-top: 8vh;
    align-self: center;
  }

  .hero-frame-block--role {
    order: 2;
    margin-top: -6vh;
    align-self: center;
    max-width: 380px;
  }

  .reveal-wrapper {
    overflow: hidden;
    display: block;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }

  .reveal-line {
    display: block;
    will-change: transform, opacity;
  }

  .frame-index {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent-cyan);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
  }

  .frame-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.25rem, 1.8vw, 1.65rem);
    color: var(--text-primary);
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .frame-desc {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-secondary);
    max-width: 32ch;
    line-height: 1.55;
    font-weight: 400;
  }

  .frame-stack {
    font-family: var(--font-mono);
    font-size: 11px;
    color: rgba(255, 255, 255, 0.72);
    border-top: 1px solid var(--border-subtle);
    padding-top: 0.75rem;
    letter-spacing: -0.01em;
    max-width: 34ch;
    font-weight: 450;
  }

  .frame-index-desktop,
  .frame-title-desktop,
  .frame-desc-desktop {
    display: inline;
  }

  .frame-index-mobile,
  .frame-title-mobile,
  .frame-desc-mobile {
    display: none;
  }

  .frame-desc-wrapper-desktop {
    display: block;
  }

  .marquee-wrapper {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100vw;
    max-width: 100%;
    overflow: hidden;
    white-space: nowrap;
    user-select: none;
    pointer-events: none;
    padding-bottom: 1.5vh;
    z-index: 2;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .marquee-text {
    display: inline-block;
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 11vw, 12rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    padding-right: 0.05em;
  }

  @media (max-width: 768px) {
    .hero-container {
      height: 100dvh;
      min-height: -webkit-fill-available;
      max-height: 100dvh;
      padding: 4.5rem 1.25rem 0.75rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
    }

    .hero-centerpiece {
      position: absolute;
      inset: 0;
      top: 0;
      left: 0;
      transform: none;
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
      z-index: 1;
    }

    .hero-framing {
      position: relative;
      z-index: 2;
      width: 100%;
      height: 100%;
      max-width: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding-inline: 0;
      margin: 0;
      flex: 1;
      pointer-events: none;
      margin-bottom: 0;
    }

    .hero-frame-block {
      pointer-events: auto;
      max-width: 100%;
      margin-top: 0 !important;
      gap: 0.35rem;
    }

    .hero-frame-block--role {
      order: 1;
      align-self: flex-start;
      max-width: 100%;
    }

    .hero-frame-block--role .frame-index {
      font-size: 10px;
      color: var(--text-muted);
    }

    .hero-frame-block--role .frame-title--role {
      font-size: clamp(1.4rem, 6.2vw, 1.85rem);
      font-weight: 600;
      line-height: 1.05;
      letter-spacing: -0.02em;
    }

    .hero-frame-block--role .frame-stack {
      font-size: 10px;
      color: rgba(255, 255, 255, 0.72);
      letter-spacing: -0.01em;
      border-top: 1px solid var(--border-subtle);
      padding-top: 0.35rem;
      max-width: 100%;
      font-weight: 450;
    }

    .frame-desc-wrapper-desktop {
      display: none;
    }

    .hero-frame-block--solutions {
      order: 2;
      align-self: flex-start;
      margin-bottom: 0.4rem;
      max-width: 100%;
    }

    .hero-frame-block--solutions .frame-index {
      font-size: 10px;
      color: var(--text-muted);
    }

    .hero-frame-block--solutions .frame-title--solutions {
      font-size: clamp(1.05rem, 4.4vw, 1.25rem);
      font-weight: 500;
      line-height: 1.2;
    }

    .hero-frame-block--solutions .frame-desc {
      font-size: 12px;
      color: var(--text-secondary);
      line-height: 1.45;
      text-wrap: balance;
      max-width: 36ch;
    }

    .frame-index-desktop,
    .frame-title-desktop,
    .frame-desc-desktop {
      display: none;
    }

    .frame-index-mobile,
    .frame-title-mobile,
    .frame-desc-mobile {
      display: inline;
    }

    .marquee-wrapper {
      padding-bottom: 0.35rem;
    }

    .marquee-text {
      font-size: clamp(2.4rem, 9.5vw, 3.5rem);
      line-height: 0.92;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-line {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
