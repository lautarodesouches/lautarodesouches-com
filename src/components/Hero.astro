---
import HeroCanvas from './hero/HeroCanvas.astro'
---

<section class="hero-container" id="hero">
  <div class="hero-centerpiece" aria-hidden="true">
    <HeroCanvas />
  </div>

  <div class="hero-framing">
    <div class="hero-frame-block hero-frame-block--left">
      <div class="reveal-wrapper">
        <span class="frame-index reveal-line">01 // EMPRESAS & NEGOCIOS</span>
      </div>
      <div class="reveal-wrapper">
        <h2 class="frame-title reveal-line">Sitios web y sistemas a medida de punta a punta.</h2>
      </div>
      <div class="reveal-wrapper">
        <p class="frame-desc reveal-line">
          Desarrollo desde cero para pequeñas y grandes empresas: desde presencias corporativas de alta conversión hasta plataformas empresariales complejas.
        </p>
      </div>
    </div>

    <div class="hero-frame-block hero-frame-block--right">
      <div class="reveal-wrapper">
        <span class="frame-index reveal-line">02 // INGENIERÍA DE SOFTWARE</span>
      </div>
      <div class="reveal-wrapper">
        <h1 class="frame-title reveal-line">Desarrollador Web Full Stack</h1>
      </div>
      <div class="reveal-wrapper">
        <p class="frame-desc reveal-line">
          Arquitectura frontend y backend en producción. Interfaces fluidas, APIs resilientes, tipado estricto y rendimiento optimizado.
        </p>
      </div>
      <div class="reveal-wrapper">
        <div class="frame-stack reveal-line">
          TypeScript · React / Next.js · Node / NestJS · Astro · SQL
        </div>
      </div>
    </div>
  </div>

  <div class="marquee-wrapper" aria-hidden="true">
    <div class="marquee-track">
      <span class="marquee-text">Full Stack Engineering — Software de Alta Precisión — Arquitectura Escalable — Rendimiento Extremo — Interfaces Fluidas — Persistencia Resiliente —&nbsp;</span>
      <span class="marquee-text">Full Stack Engineering — Software de Alta Precisión — Arquitectura Escalable — Rendimiento Extremo — Interfaces Fluidas — Persistencia Resiliente —&nbsp;</span>
      <span class="marquee-text">Full Stack Engineering — Software de Alta Precisión — Arquitectura Escalable — Rendimiento Extremo — Interfaces Fluidas — Persistencia Resiliente —&nbsp;</span>
      <span class="marquee-text">Full Stack Engineering — Software de Alta Precisión — Arquitectura Escalable — Rendimiento Extremo — Interfaces Fluidas — Persistencia Resiliente —&nbsp;</span>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const track = document.querySelector('.marquee-track') as HTMLElement | null

  if (!isReducedMotion && track) {
    let xPercent = 0
    let direction = -1
    const baseSpeed = 0.0045

    ScrollTrigger.create({
      onUpdate: (self) => {
        direction = self.direction === 1 ? -1 : 1
      },
    })

    gsap.ticker.add((_time, deltaTime) => {
      const deltaFactor = Math.min(deltaTime / 16.667, 2)
      xPercent += baseSpeed * direction * deltaFactor
      if (xPercent <= -50) xPercent = 0
      if (xPercent > 0) xPercent = -50
      gsap.set(track, { xPercent })
    })
  }

  if (!isReducedMotion) {
    gsap.fromTo(
      '.reveal-line',
      { yPercent: 100, opacity: 0 },
      {
        yPercent: 0,
        opacity: 1,
        duration: 0.9,
        ease: 'power3.out',
        stagger: 0.08,
      }
    )
  } else {
    gsap.set('.reveal-line', { yPercent: 0, opacity: 1 })
  }
</script>

<style>
  .hero-container {
    position: relative;
    height: 100vh;
    min-height: 640px;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: calc(var(--header-height, 80px) + 1.5rem) 0 0;
    overflow: hidden;
    background-color: var(--bg-primary);
  }

  .hero-centerpiece {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 1;
  }

  .hero-framing {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-inline: clamp(1.5rem, 4vw, 4rem);
    pointer-events: none;
    flex: 1;
    margin-bottom: clamp(4.5rem, 10vh, 8rem);
  }

  .hero-frame-block {
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 360px;
  }

  .hero-frame-block--left {
    margin-top: 8vh;
    align-self: center;
  }

  .hero-frame-block--right {
    margin-top: -6vh;
    align-self: center;
    max-width: 380px;
  }

  .reveal-wrapper {
    overflow: hidden;
    display: block;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }

  .reveal-line {
    display: block;
    will-change: transform, opacity;
  }

  .frame-index {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent-cyan);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
  }

  .frame-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.25rem, 1.8vw, 1.65rem);
    color: var(--text-primary);
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .frame-desc {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--text-secondary);
    max-width: 32ch;
    line-height: 1.55;
    font-weight: 400;
  }

  .frame-stack {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    border-top: 1px solid var(--border-subtle);
    padding-top: 0.75rem;
    letter-spacing: -0.01em;
    max-width: 34ch;
  }

  .marquee-wrapper {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100vw;
    overflow: hidden;
    white-space: nowrap;
    user-select: none;
    pointer-events: none;
    padding-bottom: 1.5vh;
    z-index: 2;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .marquee-text {
    display: inline-block;
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 11vw, 12rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    padding-right: 0.05em;
  }

  @media (max-width: 1024px) {
    .hero-container {
      height: auto;
      min-height: 100vh;
      padding-top: calc(var(--header-height, 80px) + 1.5rem);
      padding-bottom: clamp(4.5rem, 11vw, 8rem);
    }

    .hero-centerpiece {
      opacity: 0.55;
      transition: opacity 0.3s ease;
    }

    .hero-framing {
      flex-direction: column;
      justify-content: flex-start;
      gap: 2.25rem;
      margin-bottom: 2rem;
      padding-inline: 1.5rem;
    }

    .hero-frame-block {
      max-width: 100%;
      margin-top: 0 !important;
      align-self: flex-start;
    }

    .hero-frame-block--right {
      order: 1;
    }

    .hero-frame-block--left {
      order: 2;
    }

    .frame-title {
      font-size: clamp(1.2rem, 4vw, 1.45rem);
    }

    .frame-desc {
      max-width: 100%;
    }

    .frame-stack {
      max-width: 100%;
    }
  }

  @media (max-height: 700px) and (max-width: 1024px) {
    .hero-framing {
      gap: 1.25rem;
    }

    .frame-desc {
      display: none;
    }

    .frame-stack {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-line {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
