---
---

<div class="mobile-nav-root">
  <button
    type="button"
    class="mobile-nav-trigger"
    id="mobile-nav-trigger"
    aria-label="Abrir menú de navegación"
    aria-expanded="false"
    aria-controls="mobile-nav-overlay"
  >
    <div class="trigger-lines" aria-hidden="true">
      <span class="trigger-line trigger-line--top"></span>
      <span class="trigger-line trigger-line--bottom"></span>
    </div>
  </button>

  <div
    class="mobile-nav-overlay"
    id="mobile-nav-overlay"
    aria-hidden="true"
  >
    <svg
      class="mobile-nav-svg"
      viewBox="0 0 100 100"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path
        id="mobile-nav-path"
        d="M 0 0 L 100 0 L 100 0 Q 50 0 0 0 Z"
        fill="#0A0A0A"
      ></path>
    </svg>

    <div class="mobile-nav-content" id="mobile-nav-content">
      <div class="mobile-nav-header">
        <span class="mobile-nav-tag">NAVEGACIÓN // 2026</span>
      </div>

      <nav class="mobile-nav-menu" aria-label="Navegación móvil principal">
        <ul class="mobile-nav-list">
          <li class="mobile-nav-item">
            <div class="nav-link-mask">
              <a href="#soluciones" class="mobile-nav-link">
                <span class="nav-link-index">01</span>
                <span class="nav-link-text">Soluciones</span>
              </a>
            </div>
          </li>
          <li class="mobile-nav-item">
            <div class="nav-link-mask">
              <a href="#proyectos" class="mobile-nav-link">
                <span class="nav-link-index">02</span>
                <span class="nav-link-text">Proyectos</span>
              </a>
            </div>
          </li>
          <li class="mobile-nav-item">
            <div class="nav-link-mask">
              <a href="#trayectoria" class="mobile-nav-link">
                <span class="nav-link-index">03</span>
                <span class="nav-link-text">Trayectoria</span>
              </a>
            </div>
          </li>
          <li class="mobile-nav-item">
            <div class="nav-link-mask">
              <a href="#contacto" class="mobile-nav-link">
                <span class="nav-link-index">04</span>
                <span class="nav-link-text">Contacto</span>
              </a>
            </div>
          </li>
        </ul>
      </nav>

      <div class="mobile-nav-footer">
        <a
          href="https://github.com/lautarodesouches"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-link"
        >
          GitHub
        </a>
        <a
          href="https://linkedin.com/in/lautarodesouches"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-link"
        >
          LinkedIn
        </a>
        <a href="mailto:lautarodesouches@outlook.com" class="footer-link">
          Email
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  import { gsap } from 'gsap'

  interface LenisInstance {
    stop: () => void
    start: () => void
    scrollTo: (target: string | HTMLElement, opts?: { duration?: number; offset?: number }) => void
  }

  interface WindowWithLenis extends Window {
    __lenis?: LenisInstance
  }

  const trigger = document.getElementById('mobile-nav-trigger')
  const overlay = document.getElementById('mobile-nav-overlay')
  const content = document.getElementById('mobile-nav-content')
  const path = document.getElementById('mobile-nav-path')
  const links = document.querySelectorAll('.mobile-nav-link')

  if (trigger && overlay && content && path) {
    const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    const initialPath = 'M 0 0 L 100 0 L 100 0 Q 50 0 0 0 Z'
    const curveDownPath = 'M 0 0 L 100 0 L 100 100 Q 50 135 0 100 Z'
    const flatPath = 'M 0 0 L 100 0 L 100 100 Q 50 100 0 100 Z'
    const curveUpPath = 'M 0 0 L 100 0 L 100 0 Q 50 -35 0 0 Z'

    let isOpen = false
    let isAnimating = false

    const getLenis = (): LenisInstance | undefined => {
      return (window as unknown as WindowWithLenis).__lenis
    }

    const openMenu = () => {
      if (isAnimating) return
      isAnimating = true
      isOpen = true

      trigger.classList.add('is-open')
      trigger.setAttribute('aria-expanded', 'true')
      overlay.setAttribute('aria-hidden', 'false')
      document.body.classList.add('menu-open')
      getLenis()?.stop()

      if (isReducedMotion) {
        gsap.set(overlay, { visibility: 'visible', pointerEvents: 'auto' })
        gsap.set(path, { attr: { d: flatPath } })
        gsap.fromTo(content, { opacity: 0 }, { opacity: 1, duration: 0.25, onComplete: () => { isAnimating = false } })
        return
      }

      const tl = gsap.timeline({
        onComplete: () => {
          isAnimating = false
        },
      })

      tl.set(overlay, { visibility: 'visible', pointerEvents: 'auto' })
        .set(path, { attr: { d: initialPath } })
        .set(content, { opacity: 1 })
        .to(path, {
          attr: { d: curveDownPath },
          duration: 0.45,
          ease: 'power3.in',
        })
        .to(path, {
          attr: { d: flatPath },
          duration: 0.32,
          ease: 'power2.out',
        })
        .fromTo(
          '.mobile-nav-link',
          { yPercent: 120, opacity: 0 },
          {
            yPercent: 0,
            opacity: 1,
            duration: 0.55,
            ease: 'power3.out',
            stagger: 0.07,
          },
          '-=0.22'
        )
        .fromTo(
          ['.mobile-nav-tag', '.mobile-nav-footer'],
          { opacity: 0, y: 14 },
          {
            opacity: 1,
            y: 0,
            duration: 0.4,
            ease: 'power2.out',
            stagger: 0.05,
          },
          '-=0.3'
        )
    }

    const closeMenu = (onClosed?: () => void) => {
      if (isAnimating) return
      isAnimating = true
      isOpen = false

      trigger.classList.remove('is-open')
      trigger.setAttribute('aria-expanded', 'false')
      overlay.setAttribute('aria-hidden', 'true')

      if (isReducedMotion) {
        gsap.to(content, {
          opacity: 0,
          duration: 0.2,
          onComplete: () => {
            gsap.set(overlay, { visibility: 'hidden', pointerEvents: 'none' })
            document.body.classList.remove('menu-open')
            getLenis()?.start()
            isAnimating = false
            onClosed?.()
          },
        })
        return
      }

      const tl = gsap.timeline({
        onComplete: () => {
          gsap.set(overlay, { visibility: 'hidden', pointerEvents: 'none' })
          document.body.classList.remove('menu-open')
          getLenis()?.start()
          isAnimating = false
          onClosed?.()
        },
      })

      tl.to('.mobile-nav-link', {
        yPercent: -80,
        opacity: 0,
        duration: 0.25,
        stagger: 0.04,
        ease: 'power2.in',
      })
        .to(
          ['.mobile-nav-tag', '.mobile-nav-footer'],
          { opacity: 0, duration: 0.18, ease: 'power2.in' },
          '<0.05'
        )
        .to(path, {
          attr: { d: curveUpPath },
          duration: 0.42,
          ease: 'power3.in',
        })
        .set(path, { attr: { d: initialPath } })
    }

    trigger.addEventListener('click', () => {
      if (isOpen) {
        closeMenu()
      } else {
        openMenu()
      }
    })

    links.forEach((link) => {
      link.addEventListener('click', (event) => {
        const href = link.getAttribute('href')
        if (href && href.startsWith('#')) {
          event.preventDefault()
          closeMenu(() => {
            const lenis = getLenis()
            if (lenis) {
              lenis.scrollTo(href, { duration: 1.2, offset: 0 })
            } else {
              const target = document.querySelector(href)
              target?.scrollIntoView({ behavior: 'smooth' })
            }
          })
        }
      })
    })

    window.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key === 'Escape' && isOpen) {
        closeMenu()
      }
    })
  }
</script>

<style>
  :global(body.menu-open) {
    overflow: hidden !important;
    touch-action: none !important;
  }

  .mobile-nav-root {
    display: none;
  }

  @media (max-width: 768px) {
    .mobile-nav-root {
      display: flex;
      align-items: center;
    }
  }

  .mobile-nav-trigger {
    position: relative;
    z-index: 1001;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .mobile-nav-trigger:active {
    transform: scale(0.95);
  }

  .trigger-lines {
    position: relative;
    width: 18px;
    height: 7px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .trigger-line {
    display: block;
    width: 18px;
    height: 1.5px;
    background-color: var(--text-primary);
    border-radius: 1px;
    transform-origin: center;
    transition: transform 0.35s cubic-bezier(0.76, 0, 0.24, 1), background-color 0.2s ease;
  }

  .mobile-nav-trigger.is-open .trigger-line--top {
    transform: translateY(2.75px) rotate(45deg);
  }

  .mobile-nav-trigger.is-open .trigger-line--bottom {
    transform: translateY(-2.75px) rotate(-45deg);
  }

  .mobile-nav-overlay {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    z-index: 1000;
    pointer-events: none;
    visibility: hidden;
    overflow: hidden;
  }

  .mobile-nav-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    will-change: transform;
  }

  .mobile-nav-content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 5.5rem 1.75rem 2.25rem;
  }

  .mobile-nav-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mobile-nav-menu {
    margin-block: auto;
  }

  .mobile-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .nav-link-mask {
    overflow: hidden;
    display: block;
  }

  .mobile-nav-link {
    display: inline-flex;
    align-items: baseline;
    gap: 1rem;
    text-decoration: none;
    color: var(--text-primary);
    will-change: transform, opacity;
  }

  .nav-link-index {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  .nav-link-text {
    font-family: var(--font-display);
    font-size: clamp(2rem, 7.5vw, 2.75rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
    transition: transform 0.25s ease, color 0.25s ease;
  }

  .mobile-nav-link:hover .nav-link-text,
  .mobile-nav-link:active .nav-link-text {
    color: var(--accent-cyan);
    transform: translateX(4px);
  }

  .mobile-nav-footer {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    border-top: 1px solid var(--border-subtle);
    padding-top: 1.25rem;
  }

  .footer-link {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-secondary);
    text-decoration: none;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  .footer-link:hover,
  .footer-link:active {
    color: var(--text-primary);
  }
</style>
