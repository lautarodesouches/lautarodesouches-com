---
import ProjectsStack from './projects/ProjectsStack.astro'
import ProjectsGrid from './projects/ProjectsGrid.astro'
import ProjectsTester from './projects/ProjectsTester.astro'
---

<section
  id="proyectos"
  class="projects-section"
  data-projects-layout="stack"
  aria-labelledby="projects-title"
>
  <div class="projects-container">
    <header class="projects-header">
      <span class="section-tag">02 // CASOS DE ESTUDIO & PROYECTOS</span>
      <h2 class="section-title" id="projects-title">Ingeniería de software aplicada a negocio.</h2>
      <p class="section-desc">
        Plataformas B2B, portales de alto tráfico y arquitecturas web de ultra-velocidad desplegadas en producción.
      </p>
    </header>

    <div id="projects-layout-stack" class="projects-view">
      <ProjectsStack />
    </div>

    <div id="projects-layout-grid" class="projects-view">
      <ProjectsGrid />
    </div>
  </div>

  <ProjectsTester />
</section>

<style>
  .projects-section {
    position: relative;
    background-color: #0A0A0A;
    color: var(--text-primary);
    padding: 6rem 2rem 8rem;
    overflow: clip;
    border-top: 1px solid var(--border-subtle);
  }

  .projects-container {
    max-width: 1360px;
    margin: 0 auto;
    width: 100%;
  }

  .projects-header {
    max-width: 820px;
    margin-bottom: 4rem;
  }

  .section-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
  }

  .section-desc {
    font-family: var(--font-sans);
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 680px;
  }

  .projects-view {
    display: none;
    width: 100%;
  }

  .projects-section[data-projects-layout="stack"] #projects-layout-stack,
  :global([data-projects-layout="stack"]) #projects-layout-stack {
    display: block;
  }

  .projects-section[data-projects-layout="grid"] #projects-layout-grid,
  :global([data-projects-layout="grid"]) #projects-layout-grid {
    display: block;
  }

  @media (max-width: 1023px) {
    .projects-section {
      padding: 5rem 1.5rem 6.5rem;
    }

    .projects-header {
      margin-bottom: 3rem;
    }
  }

  @media (max-width: 640px) {
    .projects-section {
      padding: 4rem 1.15rem 5.5rem;
    }

    .section-title {
      font-size: clamp(1.85rem, 7.5vw, 2.4rem);
      margin-bottom: 1rem;
    }

    .section-desc {
      font-size: 14px;
      line-height: 1.5;
    }
  }
</style>
