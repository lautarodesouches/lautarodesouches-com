---
import { portfolioData } from '../data/portfolio.data'

const projects = portfolioData.projects
const totalProjects = projects.length

const getHostname = (url: string) => {
  try {
    return new URL(url).hostname.replace(/^www\./, '')
  } catch {
    return 'demo.local'
  }
}
---

<section id="proyectos" class="projects-section" aria-labelledby="projects-title">
  <div class="projects-container">
    <header class="projects-header">
      <span class="section-tag">02 // CASOS DE ESTUDIO & PROYECTOS</span>
      <h2 class="section-title" id="projects-title">Ingeniería de software aplicada a negocio.</h2>
      <p class="section-desc">
        Plataformas B2B, portales de alto tráfico y arquitecturas web de ultra-velocidad desplegadas en producción.
      </p>
    </header>

    <div class="projects-split-container">
      <div class="projects-narrative-col">
        {projects.map((project, index) => {
          const isPrivate = project.isPrivateRepo
          const hostname = getHostname(project.demoUrl)

          return (
            <article
              class:list={['project-story-item', { 'is-active': index === 0 }]}
              data-index={index}
              id={`project-story-${project.id}`}
            >
              <div class="story-mobile-mockup">
                <div class="mobile-browser">
                  <div class="mobile-browser__bar">
                    <div class="mobile-dots" aria-hidden="true">
                      <span class="dot"></span>
                      <span class="dot"></span>
                      <span class="dot"></span>
                    </div>
                    <div class="mobile-url">
                      <span class="url-protocol">https://</span>
                      <span class="url-host">{hostname}</span>
                    </div>
                  </div>
                  <div class="mobile-viewport">
                    <a
                      href={project.demoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="viewport-link"
                      aria-label={`Ver proyecto ${project.title}`}
                    >
                      <img
                        src={project.image}
                        alt={`Mockup de ${project.title}`}
                        class="mobile-img"
                        loading={index === 0 ? 'eager' : 'lazy'}
                        decoding="async"
                      />
                    </a>
                  </div>
                </div>
              </div>

              <div class="story-content">
                <div class="story-telemetry">
                  <span class="story-badge">
                    [ {String(index + 1).padStart(2, '0')} / {String(totalProjects).padStart(2, '0')} ] // {project.badge}
                  </span>
                  <span class="story-type">{project.type}</span>
                </div>

                <h3 class="story-title">{project.title}</h3>

                <div class="story-narrative">
                  <div class="narrative-block">
                    <span class="narrative-label">// DESAFÍO DE NEGOCIO</span>
                    <p class="narrative-text">{project.problem}</p>
                  </div>
                  <div class="narrative-block">
                    <span class="narrative-label">// SOLUCIÓN DE ARQUITECTURA</span>
                    <p class="narrative-text">{project.solution}</p>
                  </div>
                </div>

                <div class="story-metrics">
                  {project.metrics.map((metric) => (
                    <div class="metric-card">
                      <span class="metric-label">{metric.label}</span>
                      <span class="metric-value">{metric.value}</span>
                    </div>
                  ))}
                </div>

                <div class="story-stack">
                  <span class="stack-heading">Stack Tecnológico</span>
                  <div class="stack-pills">
                    {project.tech.map((techItem) => (
                      <span class="tech-pill">{techItem}</span>
                    ))}
                  </div>
                </div>

                <div class="story-actions">
                  <a
                    href={project.demoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="action-btn action-btn--primary"
                  >
                    <span>Ver Proyecto en Producción</span>
                    <span class="action-arrow" aria-hidden="true">↗</span>
                  </a>

                  {isPrivate ? (
                    <span class="private-badge">[ REPOSITORIO PRIVADO // NDA ]</span>
                  ) : (
                    <a
                      href={project.repoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="action-btn action-btn--secondary"
                    >
                      <span>Código en GitHub</span>
                      <span class="action-arrow" aria-hidden="true">↗</span>
                    </a>
                  )}
                </div>
              </div>
            </article>
          )
        })}
      </div>

      <div class="projects-visual-stage">
        <div class="projects-ambient-backdrop" aria-hidden="true">
          <div class="ambient-spotlight" id="projects-spotlight"></div>
          <div class="ambient-watermark-wrap">
            <div class="ambient-watermark" id="projects-watermark">01</div>
          </div>
        </div>

        <div class="mockup-viewport-frame">
          <div class="mockup-header-bar">
            <div class="mockup-dots" aria-hidden="true">
              <span class="dot"></span>
              <span class="dot"></span>
              <span class="dot"></span>
            </div>
            <div class="mockup-url-pill">
              <span class="url-protocol">https://</span>
              <span class="mockup-url-label" id="mockup-url-display">
                {getHostname(projects[0].demoUrl)}
              </span>
            </div>
          </div>

          <div class="mockup-layers-stack">
            {projects.map((project, index) => {
              const num = String(index + 1).padStart(2, '0')
              const host = getHostname(project.demoUrl)

              return (
                <div
                  class:list={['mockup-layer', { 'is-active': index === 0 }]}
                  data-layer={index}
                  data-url={host}
                >
                  <a
                    href={project.demoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="layer-link"
                    aria-label={`Ver demostración de ${project.title}`}
                  >
                    <div class="layer-fallback" aria-hidden="true">
                      <span class="fallback-index">{num} // {project.badge}</span>
                      <span class="fallback-title">{project.title}</span>
                      <span class="fallback-host">{host}</span>
                    </div>

                    <img
                      src={project.image}
                      alt={`Mockup de ${project.title}`}
                      class="layer-img"
                      loading="eager"
                      decoding="async"
                      onerror="this.style.opacity='0'"
                    />

                    <div class="layer-overlay" aria-hidden="true">
                      <span class="overlay-pill">
                        <span>Ver Proyecto</span>
                        <span class="action-arrow">↗</span>
                      </span>
                    </div>
                  </a>
                </div>
              )
            })}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  function initProjectsShowcase() {
    const section = document.getElementById('proyectos')
    if (!section) return

    const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const mm = gsap.matchMedia()

    mm.add('(min-width: 1024px)', () => {
      const storyItems = gsap.utils.toArray<HTMLElement>('#proyectos .project-story-item')
      const layers = gsap.utils.toArray<HTMLElement>('#proyectos .mockup-layer')
      const urlDisplay = document.getElementById('mockup-url-display')
      const spotlight = document.getElementById('projects-spotlight')
      const watermark = document.getElementById('projects-watermark')

      if (!storyItems.length || !layers.length) return

      let activeIndex = 0
      let zCounter = 10

      layers.forEach((layer, idx) => {
        const inner = layer.querySelector<HTMLElement>('.layer-link')
        const img = layer.querySelector<HTMLElement>('.layer-img')

        if (idx === 0) {
          gsap.set(layer, { yPercent: 0, autoAlpha: 1, zIndex: zCounter })
          if (inner) gsap.set(inner, { yPercent: 0 })
          if (img) gsap.set(img, { scale: 1, yPercent: 0 })
        } else {
          gsap.set(layer, { yPercent: 100, autoAlpha: 0, zIndex: 1 })
          if (inner) gsap.set(inner, { yPercent: -100 })
          if (img) gsap.set(img, { scale: 1.08, yPercent: 0 })
        }
      })

      const setActiveProject = (newIndex: number) => {
        if (newIndex === activeIndex || newIndex < 0 || newIndex >= layers.length) return

        const isForward = newIndex > activeIndex
        const prevIndex = activeIndex
        activeIndex = newIndex

        storyItems.forEach((item, idx) => {
          item.classList.toggle('is-active', idx === newIndex)
        })

        const incomingLayer = layers[newIndex]
        const outgoingLayer = layers[prevIndex]
        if (!incomingLayer || !outgoingLayer) return

        const incomingInner = incomingLayer.querySelector<HTMLElement>('.layer-link')
        const incomingImg = incomingLayer.querySelector<HTMLElement>('.layer-img')
        const outgoingImg = outgoingLayer.querySelector<HTMLElement>('.layer-img')

        zCounter += 1
        incomingLayer.classList.add('is-active')
        outgoingLayer.classList.remove('is-active')

        gsap.killTweensOf([incomingLayer, incomingInner, incomingImg, outgoingImg])

        if (isReducedMotion) {
          gsap.set(incomingLayer, { yPercent: 0, autoAlpha: 1, zIndex: zCounter })
          if (incomingInner) gsap.set(incomingInner, { yPercent: 0 })
          if (incomingImg) gsap.set(incomingImg, { scale: 1, yPercent: 0 })
          gsap.set(outgoingLayer, { autoAlpha: 0 })
        } else {
          const startY = isForward ? 100 : -100

          gsap.set(incomingLayer, {
            yPercent: startY,
            autoAlpha: 1,
            zIndex: zCounter,
          })

          if (incomingInner) {
            gsap.set(incomingInner, { yPercent: -startY })
          }

          if (incomingImg) {
            gsap.set(incomingImg, { scale: 1.1, yPercent: isForward ? -6 : 6 })
          }

          const tl = gsap.timeline({
            defaults: { duration: 0.72, ease: 'power3.out' },
          })

          tl.to(incomingLayer, { yPercent: 0 }, 0)

          if (incomingInner) {
            tl.to(incomingInner, { yPercent: 0 }, 0)
          }

          if (incomingImg) {
            tl.to(incomingImg, { scale: 1, yPercent: 0 }, 0)
          }

          if (outgoingImg) {
            tl.to(
              outgoingImg,
              {
                scale: 0.96,
                yPercent: isForward ? -5 : 5,
                duration: 0.72,
                ease: 'power3.out',
              },
              0
            )
          }

          if (spotlight) {
            gsap.killTweensOf(spotlight)
            gsap.fromTo(
              spotlight,
              { scale: 0.85, opacity: 0.35 },
              {
                scale: 1.18,
                opacity: 0.9,
                duration: 0.45,
                ease: 'power2.out',
                yoyo: true,
                repeat: 1,
              }
            )
          }

          if (watermark) {
            const nextNum = String(newIndex + 1).padStart(2, '0')
            const dir = isForward ? 1 : -1
            gsap.killTweensOf(watermark)
            gsap.to(watermark, {
              yPercent: -35 * dir,
              opacity: 0,
              duration: 0.2,
              ease: 'power2.in',
              onComplete: () => {
                watermark.textContent = nextNum
                gsap.fromTo(
                  watermark,
                  { yPercent: 35 * dir, opacity: 0 },
                  { yPercent: 0, opacity: 1, duration: 0.32, ease: 'power2.out' }
                )
              },
            })
          }
        }

        if (urlDisplay) {
          const nextUrl = incomingLayer.getAttribute('data-url') || ''
          gsap.killTweensOf(urlDisplay)
          gsap.to(urlDisplay, {
            opacity: 0,
            y: -4,
            duration: 0.15,
            onComplete: () => {
              urlDisplay.textContent = nextUrl
              gsap.fromTo(
                urlDisplay,
                { opacity: 0, y: 4 },
                { opacity: 1, y: 0, duration: 0.22 }
              )
            },
          })
        }
      }

      storyItems.forEach((item, index) => {
        ScrollTrigger.create({
          trigger: item,
          start: 'top 55%',
          end: 'bottom 45%',
          onEnter: () => setActiveProject(index),
          onEnterBack: () => setActiveProject(index),
        })
      })

      requestAnimationFrame(() => {
        ScrollTrigger.refresh()
      })
    })
  }

  initProjectsShowcase()
  document.addEventListener('astro:page-load', initProjectsShowcase)
</script>

<style>
  .projects-section {
    position: relative;
    background-color: #0A0A0A;
    color: var(--text-primary);
    padding: 6rem 2rem 8rem;
    overflow-x: clip;
    border-top: 1px solid var(--border-subtle);
  }

  .projects-container {
    max-width: 1360px;
    margin: 0 auto;
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .projects-header {
    max-width: 820px;
    margin-bottom: 4rem;
  }

  .section-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
  }

  .section-desc {
    font-family: var(--font-sans);
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 680px;
  }

  .projects-split-container {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 4rem;
    position: relative;
    width: 100%;
    align-items: start;
  }

  .projects-narrative-col {
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 2;
  }

  .project-story-item {
    min-height: 92vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    opacity: 0.32;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-story-item.is-active {
    opacity: 1;
  }

  .project-story-item:last-child {
    border-bottom: none;
    min-height: 85vh;
  }

  .story-mobile-mockup {
    display: none;
  }

  .story-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .story-telemetry {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .story-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .story-type {
    font-family: var(--font-mono);
    font-size: 10px;
    color: rgba(255, 255, 255, 0.35);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .story-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 2.5vw, 2.4rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .story-narrative {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .narrative-block {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .narrative-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .narrative-text {
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .story-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    padding: 1.15rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .metric-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .metric-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .metric-value {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .story-stack {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .stack-heading {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  .stack-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tech-pill {
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1;
    color: rgba(255, 255, 255, 0.65);
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.35rem 0.6rem;
    border-radius: 4px;
    white-space: nowrap;
  }

  .story-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding-top: 0.25rem;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    padding: 0.65rem 1.15rem;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
  }

  .action-btn--primary {
    background-color: #FFFFFF;
    color: #0A0A0A;
    font-weight: 600;
  }

  .action-btn--primary:hover {
    background-color: #E6E6E6;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(255, 255, 255, 0.15);
  }

  .action-btn--secondary {
    background-color: rgba(255, 255, 255, 0.04);
    color: #FFFFFF;
    font-weight: 500;
    border: 1px solid rgba(255, 255, 255, 0.14);
  }

  .action-btn--secondary:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-1px);
  }

  .private-badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1;
    color: var(--text-muted);
    border: 1px solid rgba(255, 255, 255, 0.1);
    background-color: rgba(255, 255, 255, 0.02);
    padding: 0.65rem 0.95rem;
    border-radius: 9999px;
    letter-spacing: 0.04em;
    user-select: none;
  }

  .action-arrow {
    font-size: 12px;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .action-btn:hover .action-arrow {
    transform: translate(2px, -2px);
  }

  .projects-visual-stage {
    position: sticky;
    top: calc(var(--header-height, 72px) + 2rem);
    height: calc(100vh - var(--header-height, 72px) - 4rem);
    align-self: start;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .projects-ambient-backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: visible;
    z-index: 0;
  }

  .ambient-spotlight {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 620px;
    height: 620px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      circle,
      rgba(255, 255, 255, 0.08) 0%,
      rgba(255, 255, 255, 0.02) 40%,
      transparent 70%
    );
    filter: blur(55px);
    will-change: transform, opacity;
  }

  .ambient-watermark-wrap {
    position: absolute;
    top: 50%;
    right: -4%;
    transform: translateY(-50%);
    overflow: hidden;
    height: clamp(14rem, 24vw, 22rem);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ambient-watermark {
    font-family: var(--font-display);
    font-size: clamp(14rem, 24vw, 22rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.05em;
    color: rgba(255, 255, 255, 0.035);
    will-change: transform, opacity;
  }

  .mockup-viewport-frame {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 660px;
    background-color: #121212;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 32px 72px -16px rgba(0, 0, 0, 0.85);
    transition: border-color 0.3s ease;
  }

  .mockup-viewport-frame:hover {
    border-color: rgba(255, 255, 255, 0.22);
  }

  .mockup-header-bar {
    height: 32px;
    background-color: #161616;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1rem;
    gap: 1rem;
  }

  .mockup-dots,
  .mobile-dots {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.2);
  }

  .mockup-url-pill,
  .mobile-url {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 4px;
    padding: 0.15rem 0.65rem;
    font-family: var(--font-mono);
    font-size: 10px;
    max-width: 280px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .url-protocol {
    color: rgba(255, 255, 255, 0.25);
  }

  .mockup-url-label,
  .url-host {
    color: rgba(255, 255, 255, 0.6);
  }

  .mockup-layers-stack {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: #0D0D0D;
  }

  .mockup-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    will-change: transform;
  }

  .mockup-layer.is-active {
    pointer-events: auto;
  }

  .layer-link,
  .viewport-link {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    will-change: transform;
    background-color: #0D0D0D;
  }

  .layer-fallback {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
