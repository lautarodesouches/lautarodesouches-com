---
import { portfolioData } from '../data/portfolio.data'

const projects = portfolioData.projects
const firstProject = projects[0]
const totalProjects = projects.length
---

<section id="proyectos" class="projects-section" aria-labelledby="projects-title">
  <div class="projects-container">
    <header class="projects-header">
      <span class="section-tag">02 // CASOS DE ESTUDIO & PROYECTOS</span>
      <h2 class="section-title" id="projects-title">Ingeniería de software aplicada a negocio.</h2>
      <p class="section-desc">
        Plataformas B2B, portales de alto tráfico y arquitecturas web de ultra-velocidad desplegadas en producción.
      </p>
    </header>

    <div class="projects-grid">
      <aside class="projects-sticky-panel" aria-label="Detalles del proyecto activo">
        <div class="panel-content" id="pinned-project-info">
          <div class="panel-telemetry">
            <div class="panel-counter">
              [ <span class="counter-curr">01</span> / <span class="counter-total">{String(totalProjects).padStart(2, '0')}</span> ]
            </div>
            <div class="panel-segments" aria-hidden="true">
              {projects.map((_, idx) => (
                <span class:list={['panel-segment', { 'is-active': idx === 0 }]}></span>
              ))}
            </div>
          </div>

          <div class="panel-meta">
            <span class="panel-badge">{firstProject.badge}</span>
            <span class="panel-type">{firstProject.type}</span>
          </div>

          <h3 class="panel-title">{firstProject.title}</h3>

          <div class="panel-narrative">
            <div class="narrative-block">
              <span class="narrative-label">// DESAFÍO DE NEGOCIO</span>
              <p class="narrative-text">{firstProject.problem}</p>
            </div>
            <div class="narrative-block">
              <span class="narrative-label">// SOLUCIÓN DE ARQUITECTURA</span>
              <p class="narrative-text">{firstProject.solution}</p>
            </div>
          </div>

          <div class="panel-metrics">
            {firstProject.metrics.map((m) => (
              <div class="panel-metric-box">
                <span class="metric-label">{m.label}</span>
                <span class="metric-value">{m.value}</span>
              </div>
            ))}
          </div>

          <div class="panel-stack">
            <span class="stack-label">Stack Tecnológico</span>
            <div class="panel-pills">
              {firstProject.tech.map((t) => (
                <span class="panel-pill">{t}</span>
              ))}
            </div>
          </div>

          <div class="panel-actions">
            <a
              href={firstProject.demoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="panel-btn panel-btn--primary"
            >
              <span>Ver Proyecto en Producción</span>
              <span class="btn-arrow" aria-hidden="true">↗</span>
            </a>

            {firstProject.isPrivateRepo ? (
              <span class="private-badge">[ REPOSITORIO PRIVADO // NDA ]</span>
            ) : (
              <a
                href={firstProject.repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="panel-btn panel-btn--secondary"
              >
                <span>Código en GitHub</span>
                <span class="btn-arrow" aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </div>
      </aside>

      <div class="projects-feed">
        {projects.map((project, index) => (
          <article class="project-card" data-project-index={index} id={`project-${project.id}`}>
            <div class="browser-frame">
              <div class="browser-chrome" aria-hidden="true">
                <div class="browser-dots">
                  <span class="browser-dot"></span>
                  <span class="browser-dot"></span>
                  <span class="browser-dot"></span>
                </div>
                <div class="browser-address">
                  <span class="browser-protocol">https://</span>
                  <span class="browser-url">{project.demoUrl.replace(/^https?:\/\//, '').replace(/\/$/, '')}</span>
                </div>
              </div>

              <div class="browser-viewport">
                <a
                  href={project.demoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="browser-link"
                  aria-label={`Ver ${project.title} en producción`}
                >
                  <img
                    src={project.image}
                    alt={`Captura técnica de ${project.title}`}
                    class="project-img"
                    loading={index === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                  <div class="browser-overlay" aria-hidden="true">
                    <span class="browser-overlay-pill">Abrir Demo ↗</span>
                  </div>
                </a>
              </div>
            </div>

            <div class="project-mobile-details">
              <div class="panel-telemetry">
                <div class="panel-counter">
                  [ <span class="counter-curr">{String(index + 1).padStart(2, '0')}</span> / <span class="counter-total">{String(totalProjects).padStart(2, '0')}</span> ]
                </div>
                <div class="panel-meta">
                  <span class="panel-badge">{project.badge}</span>
                  <span class="panel-type">{project.type}</span>
                </div>
              </div>

              <h3 class="panel-title">{project.title}</h3>

              <div class="panel-narrative">
                <div class="narrative-block">
                  <span class="narrative-label">// DESAFÍO DE NEGOCIO</span>
                  <p class="narrative-text">{project.problem}</p>
                </div>
                <div class="narrative-block">
                  <span class="narrative-label">// SOLUCIÓN DE ARQUITECTURA</span>
                  <p class="narrative-text">{project.solution}</p>
                </div>
              </div>

              <div class="panel-metrics">
                {project.metrics.map((m) => (
                  <div class="panel-metric-box">
                    <span class="metric-label">{m.label}</span>
                    <span class="metric-value">{m.value}</span>
                  </div>
                ))}
              </div>

              <div class="panel-stack">
                <span class="stack-label">Stack Tecnológico</span>
                <div class="panel-pills">
                  {project.tech.map((t) => (
                    <span class="panel-pill">{t}</span>
                  ))}
                </div>
              </div>

              <div class="panel-actions">
                <a
                  href={project.demoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="panel-btn panel-btn--primary"
                >
                  <span>Ver Proyecto en Producción</span>
                  <span class="btn-arrow" aria-hidden="true">↗</span>
                </a>

                {project.isPrivateRepo ? (
                  <span class="private-badge">[ REPOSITORIO PRIVADO // NDA ]</span>
                ) : (
                  <a
                    href={project.repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="panel-btn panel-btn--secondary"
                  >
                    <span>Código en GitHub</span>
                    <span class="btn-arrow" aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { portfolioData, type Project } from '../data/portfolio.data'

  gsap.registerPlugin(ScrollTrigger)

  const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const mm = gsap.matchMedia()

  const renderProjectDetails = (target: HTMLElement, data: Project, idx: number) => {
    const repoMarkup = data.isPrivateRepo
      ? `<span class="private-badge">[ REPOSITORIO PRIVADO // NDA ]</span>`
      : `<a href="${data.repoUrl}" target="_blank" rel="noopener noreferrer" class="panel-btn panel-btn--secondary"><span>Código en GitHub</span><span class="btn-arrow" aria-hidden="true">↗</span></a>`

    target.innerHTML = `
      <div class="panel-telemetry">
        <div class="panel-counter">
          [ <span class="counter-curr">${String(idx + 1).padStart(2, '0')}</span> / <span class="counter-total">04</span> ]
        </div>
        <div class="panel-segments" aria-hidden="true">
          ${[0, 1, 2, 3].map((s) => `<span class="panel-segment ${s === idx ? 'is-active' : ''}"></span>`).join('')}
        </div>
      </div>

      <div class="panel-meta">
        <span class="panel-badge">${data.badge}</span>
        <span class="panel-type">${data.type}</span>
      </div>

      <h3 class="panel-title">${data.title}</h3>

      <div class="panel-narrative">
        <div class="narrative-block">
          <span class="narrative-label">// DESAFÍO DE NEGOCIO</span>
          <p class="narrative-text">${data.problem}</p>
        </div>
        <div class="narrative-block">
          <span class="narrative-label">// SOLUCIÓN DE ARQUITECTURA</span>
          <p class="narrative-text">${data.solution}</p>
        </div>
      </div>

      <div class="panel-metrics">
        ${data.metrics
          .map(
            (m) => `
          <div class="panel-metric-box">
            <span class="metric-label">${m.label}</span>
            <span class="metric-value">${m.value}</span>
          </div>
        `
          )
          .join('')}
      </div>

      <div class="panel-stack">
        <span class="stack-label">Stack Tecnológico</span>
        <div class="panel-pills">
          ${data.tech.map((t) => `<span class="panel-pill">${t}</span>`).join('')}
        </div>
      </div>

      <div class="panel-actions">
        <a href="${data.demoUrl}" target="_blank" rel="noopener noreferrer" class="panel-btn panel-btn--primary">
          <span>Ver Proyecto en Producción</span>
          <span class="btn-arrow" aria-hidden="true">↗</span>
        </a>
        ${repoMarkup}
      </div>
    `
  }

  mm.add('(min-width: 1024px)', () => {
    const cards = gsap.utils.toArray<HTMLElement>('.project-card')
    let currentIndex = 0

    cards.forEach((card, index) => {
      ScrollTrigger.create({
        trigger: card,
        start: 'top 55%',
        end: 'bottom 55%',
        onEnter: () => updateActiveProject(index),
        onEnterBack: () => updateActiveProject(index),
      })

      if (!isReducedMotion) {
        const img = card.querySelector<HTMLElement>('.project-img')
        if (img) {
          gsap.fromTo(
            img,
            { yPercent: -4 },
            {
              yPercent: 4,
              ease: 'none',
              scrollTrigger: {
                trigger: card,
                start: 'top bottom',
                end: 'bottom top',
                scrub: true,
              },
            }
          )
        }
      }
    })

    const updateActiveProject = (idx: number) => {
      if (idx === currentIndex) return
      currentIndex = idx
      const data = portfolioData.projects[idx]
      const target = document.getElementById('pinned-project-info')
      if (!target || !data) return

      gsap.to(target, {
        opacity: 0,
        y: -6,
        duration: 0.18,
        ease: 'power2.in',
        onComplete: () => {
          renderProjectDetails(target, data, idx)
          gsap.to(target, { opacity: 1, y: 0, duration: 0.25, ease: 'power2.out' })
        },
      })
    }
  })
</script>

<style>
  .projects-section {
    position: relative;
    width: 100%;
    background-color: var(--bg-primary);
    padding: clamp(5.5rem, 11vh, 9rem) 2rem clamp(6.5rem, 13vh, 10.5rem);
    border-top: 1px solid var(--border-subtle);
  }

  .projects-container {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
  }

  .projects-header {
    margin-bottom: clamp(3.5rem, 7vw, 5.5rem);
    max-width: 820px;
  }

  .section-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin-bottom: 1.35rem;
  }

  .section-desc {
    font-family: var(--font-sans);
    font-size: clamp(0.98rem, 1.2vw, 1.15rem);
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 62ch;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 420px 1fr;
    gap: 4rem;
    position: relative;
    align-items: start;
  }

  .projects-sticky-panel {
    position: sticky;
    top: calc(var(--header-height, 72px) + 2rem);
    height: fit-content;
    align-self: start;
    width: 100%;
  }

  .panel-content {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    will-change: transform, opacity;
  }

  .panel-telemetry {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .panel-counter {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.06em;
  }

  .counter-curr {
    color: var(--text-primary);
  }

  .panel-segments {
    display: flex;
    align-items: center;
    gap: 5px;
    width: 72px;
    height: 3px;
  }

  .panel-segment {
    flex: 1;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.14);
    border-radius: 2px;
    transition: background-color 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .panel-segment.is-active {
    background-color: #FFFFFF;
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.4);
  }

  .panel-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .panel-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    color: var(--accent-cyan);
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 0.25rem 0.6rem;
    border-radius: 9999px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .panel-type {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: -0.01em;
  }

  .panel-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 2.5vw, 2.4rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .panel-narrative {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background-color: rgba(255, 255, 255, 0.015);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    padding: 1.1rem 1.25rem;
  }

  .narrative-block {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .narrative-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.06em;
  }

  .narrative-text {
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .panel-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.65rem;
  }

  .panel-metric-box {
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 0.65rem 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .metric-label {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .metric-value {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: #FFFFFF;
    line-height: 1.25;
  }

  .panel-stack {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stack-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .panel-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .panel-pill {
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1;
    color: var(--text-primary);
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.35rem 0.6rem;
    border-radius: 9999px;
    letter-spacing: -0.01em;
  }

  .panel-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding-top: 0.5rem;
  }

  .panel-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    padding: 0.65rem 1.15rem;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
  }

  .panel-btn--primary {
    background-color: #FFFFFF;
    color: #0A0A0A;
    font-weight: 600;
  }

  .panel-btn--primary:hover {
    background-color: #E6E6E6;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(255, 255, 255, 0.15);
  }

  .panel-btn--secondary {
    background-color: rgba(255, 255, 255, 0.04);
    color: #FFFFFF;
    font-weight: 500;
    border: 1px solid rgba(255, 255, 255, 0.14);
  }

  .panel-btn--secondary:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-1px);
  }

  .private-badge {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1;
    color: var(--text-muted);
    border: 1px solid rgba(255, 255, 255, 0.1);
    background-color: rgba(255, 255, 255, 0.02);
    padding: 0.65rem 0.95rem;
    border-radius: 9999px;
    letter-spacing: 0.04em;
    user-select: none;
  }

  .btn-arrow {
    font-size: 12px;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .panel-btn:hover .btn-arrow {
    transform: translate(2px, -2px);
  }

  .projects-feed {
    display: flex;
    flex-direction: column;
  }

  .project-card {
    position: relative;
    width: 100%;
    margin-bottom: 35vh;
  }

  .project-card:last-child {
    margin-bottom: 0;
  }

  .browser-frame {
    width: 100%;
    background-color: #121212;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.6);
    transition: border-color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-card:hover .browser-frame {
    border-color: rgba(255, 255, 255, 0.22);
  }

  .browser-chrome {
    height: 30px;
    background-color: #161616;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1rem;
    gap: 1rem;
  }

  .browser-dots {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .browser-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.18);
  }

  .browser-address {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 4px;
    padding: 0.15rem 0.65rem;
    font-family: var(--font-mono);
    font-size: 10px;
    color: rgba(255, 255, 255, 0.45);
    max-width: 280px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .browser-protocol {
    color: rgba(255, 255, 255, 0.25);
  }

  .browser-url {
    color: rgba(255, 255, 255, 0.55);
  }

  .browser-viewport {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: #0A0A0A;
  }

  .browser-link {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  .project-img {
    width: 100%;
    height: 110%;
    object-fit: cover;
    object-position: top center;
    display: block;
    will-change: transform;
  }

  .browser-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(10, 10, 10, 0.45);
    backdrop-filter: blur(2px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-card:hover .browser-overlay {
    opacity: 1;
  }

  .browser-overlay-pill {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: #FFFFFF;
    background-color: rgba(18, 18, 18, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 0.55rem 1rem;
    border-radius: 9999px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  @media (min-width: 1024px) {
    .project-mobile-details {
      display: none !important;
    }
  }

  @media (max-width: 1023px) {
    .projects-grid {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .projects-sticky-panel {
      display: none !important;
    }

    .projects-feed {
      gap: 4.5rem;
    }

    .project-card {
      margin-bottom: 0;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      background-color: rgba(255, 255, 255, 0.015);
      border: 1px solid var(--border-subtle);
      border-radius: 14px;
      padding: 1.25rem;
    }

    .project-mobile-details {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .panel-metrics {
      grid-template-columns: 1fr;
