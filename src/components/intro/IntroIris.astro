---
---

<div class="intro-iris" id="intro-iris" aria-hidden="true">
  <svg class="intro-iris-svg" width="100%" height="100%" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice">
    <defs>
      <mask id="iris-mask">
        <rect width="100" height="100" fill="#ffffff"></rect>
        <circle id="iris-mask-circle" cx="50" cy="50" r="0" fill="#000000"></circle>
      </mask>
    </defs>
    <rect width="100" height="100" fill="#0A0A0A" mask="url(#iris-mask)"></rect>
  </svg>
</div>

<script>
  import { gsap } from 'gsap'

  interface LenisInstance {
    stop: () => void
    start: () => void
  }

  interface WindowWithLenis extends Window {
    __lenis?: LenisInstance
  }

  const STORAGE_KEY = 'intro_shown'
  const curtain = document.getElementById('intro-iris')
  const circle = document.getElementById('iris-mask-circle')

  const getLenis = (): LenisInstance | undefined => {
    return (window as unknown as WindowWithLenis).__lenis
  }

  const skipIntro = () => {
    if (curtain) {
      curtain.style.display = 'none'
      curtain.remove()
    }
    document.body.classList.remove('intro-running')
    getLenis()?.start()
    window.dispatchEvent(
      new CustomEvent('intro:complete', {
        detail: { immediate: true },
      })
    )
  }

  const playIntro = () => {
    if (!curtain || !circle) return

    const isDev = import.meta.env.DEV
    const urlParams = new URLSearchParams(window.location.search)
    const hasForceParam = urlParams.has('intro') || urlParams.has('replay')
    const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const isAlreadyShown = !isDev && !hasForceParam && sessionStorage.getItem(STORAGE_KEY) === 'true'

    if (isReducedMotion || isAlreadyShown) {
      sessionStorage.setItem(STORAGE_KEY, 'true')
      skipIntro()
      return
    }

    sessionStorage.setItem(STORAGE_KEY, 'true')

    getLenis()?.stop()
    document.body.classList.add('intro-running')

    gsap.set(circle, { attr: { r: 0 } })
    gsap.set(curtain, { display: 'block', visibility: 'visible' })

    const tl = gsap.timeline({
      onComplete: () => {
        document.body.classList.remove('intro-running')
        getLenis()?.start()
        curtain.style.display = 'none'
        curtain.remove()
      },
    })

    tl.to(
      circle,
      {
        attr: { r: 85 },
        duration: 0.5,
        ease: 'expo.out',
      },
      0
    )

    tl.fromTo(
      '#hero-canvas-scale-wrapper',
      {
        scale: 0.25,
        opacity: 0.65,
      },
      {
        scale: 1,
        opacity: 1,
        duration: 0.55,
        ease: 'back.out(1.4)',
        clearProps: 'opacity',
      },
      0
    )

    tl.add(() => {
      window.dispatchEvent(
        new CustomEvent('intro:complete', {
          detail: { marqueeBoost: false },
        })
      )
    }, 0.15)
  }

  const init = () => {
    requestAnimationFrame(playIntro)
  }

  if (document.readyState === 'loading') {
    window.addEventListener('DOMContentLoaded', init)
  } else {
    init()
  }
</script>

<style>
  .intro-iris {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    z-index: 9999;
    background-color: transparent;
    pointer-events: none;
    overflow: hidden;
  }

  .intro-iris-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }

  :global(body.intro-running) {
    overflow: hidden !important;
    touch-action: none !important;
  }
</style>
