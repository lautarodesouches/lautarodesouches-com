---
import { careerData } from '../data/career.data'

const { telemetry, categories, milestones } = careerData
---

<section id="trayectoria" class="trajectory-section" aria-labelledby="trajectory-title">
  <div class="trajectory-container">
    <header class="trajectory-header">
      <span class="section-tag">03 // TRAYECTORIA & HISTORIAL TÉCNICO</span>
      <h2 class="section-title" id="trajectory-title">
        Evolución técnica, experiencia y formación rigurosa.
      </h2>
      <p class="section-desc">
        Recorrido como desarrollador e ingeniero de software, formación académica universitaria y especializaciones avanzadas en arquitecturas cliente y backend.
      </p>
    </header>

    <div class="trajectory-layout">
      <aside class="trajectory-sidebar">
        <div class="telemetry-panel">
          <div class="telemetry-panel__header">
            <span class="telemetry-panel__status-dot" aria-hidden="true"></span>
            <span class="telemetry-panel__status-label">ESTADO PROFESIONAL</span>
          </div>

          <div class="telemetry-panel__body">
            <div class="telemetry-metric">
              <span class="telemetry-metric__label">EXPERIENCIA COMERCIAL</span>
              <span class="telemetry-metric__value">{telemetry.experienceYears}</span>
              <span class="telemetry-metric__sub">{telemetry.experiencePeriod}</span>
            </div>

            <div class="telemetry-metric">
              <span class="telemetry-metric__label">GRADO UNIVERSITARIO</span>
              <span class="telemetry-metric__value">{telemetry.degreeInstitution}</span>
              <span class="telemetry-metric__sub">{telemetry.degreeTitle} // {telemetry.degreeStatus}</span>
            </div>

            <div class="telemetry-metric">
              <span class="telemetry-metric__label">COMPETENCIA BILINGÜE</span>
              <div class="telemetry-languages">
                {telemetry.languages.map((lang) => (
                  <div class="language-row">
                    <span class="language-name">{lang.language}:</span>
                    <span class="language-level">{lang.level}</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="telemetry-metric">
              <span class="telemetry-metric__label">MODALIDAD & ZONA</span>
              <span class="telemetry-metric__text">{telemetry.availability}</span>
            </div>
          </div>
        </div>

        <nav class="trajectory-filter" aria-label="Filtrar trayectoria">
          <span class="filter-heading">// FILTRAR HISTORIAL</span>
          <div class="filter-pills" role="tablist">
            {categories.map((cat, index) => (
              <button
                type="button"
                role="tab"
                class:list={['filter-pill', { 'is-active': index === 0 }]}
                data-filter={cat.id}
                aria-selected={index === 0 ? 'true' : 'false'}
              >
                <span class="filter-pill__label">{cat.label}</span>
                <span class="filter-pill__count">({cat.count})</span>
              </button>
            ))}
          </div>
        </nav>
      </aside>

      <div class="trajectory-stream">
        <div class="timeline-spine" aria-hidden="true">
          <div class="timeline-spine__progress" id="timeline-progress"></div>
        </div>

        <div class="timeline-items" id="timeline-items-list">
          {milestones.map((item, index) => (
            <article
              class="timeline-item"
              data-category={item.category}
              data-index={index}
              id={`milestone-${item.id}`}
            >
              <div class="timeline-item__anchor" aria-hidden="true">
                <span class="timeline-item__node"></span>
              </div>

              <div class="timeline-item__card">
                <header class="card-header">
                  <div class="card-meta">
                    <span class="card-period">{item.period}</span>
                    <span class="card-category">[{item.categoryLabel}]</span>
                    <span class="card-status">{item.status}</span>
                  </div>

                  <h3 class="card-role">{item.role}</h3>
                  <div class="card-entity">
                    <span class="entity-name">{item.organization}</span>
                    <span class="entity-sep">—</span>
                    <span class="entity-loc">{item.location}</span>
                  </div>
                </header>

                <p class="card-summary">{item.summary}</p>

                <div class="card-highlights">
                  <span class="highlights-title">// PUNTOS DESTACADOS & LOGROS</span>
                  <ul class="highlights-list">
                    {item.highlights.map((highlight) => (
                      <li class="highlights-item">
                        <span class="highlight-bullet" aria-hidden="true">
                          //
                        </span>
                        <span class="highlight-text">{highlight}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="card-tags">
                  {item.tags.map((tag) => (
                    <span class="tag-pill">{tag}</span>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const section = document.getElementById('trayectoria')
  const items = document.querySelectorAll<HTMLElement>('.timeline-item')
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-pill')
  const progressBar = document.getElementById('timeline-progress')
  const stream = document.querySelector<HTMLElement>('.trajectory-stream')

  if (!isReducedMotion && section && items.length > 0) {
    gsap.fromTo(
      '.trajectory-header > *',
      { opacity: 0, y: 25 },
      {
        opacity: 1,
        y: 0,
        duration: 0.8,
        stagger: 0.12,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '.trajectory-header',
          start: 'top 85%',
          toggleActions: 'play none none none',
        },
      }
    )

    items.forEach((item) => {
      gsap.fromTo(
        item,
        { opacity: 0, y: 35 },
        {
          opacity: 1,
          y: 0,
          duration: 0.75,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: item,
            start: 'top 88%',
            toggleActions: 'play none none none',
          },
        }
      )
    })

    if (progressBar && stream) {
      ScrollTrigger.create({
        trigger: stream,
        start: 'top 60%',
        end: 'bottom 85%',
        scrub: true,
        onUpdate: (self) => {
          gsap.set(progressBar, {
            scaleY: self.progress,
            transformOrigin: 'top center',
          })
        },
      })
    }
  }

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const selectedCategory = button.getAttribute('data-filter')

      filterButtons.forEach((btn) => {
        btn.classList.toggle('is-active', btn === button)
        btn.setAttribute('aria-selected', btn === button ? 'true' : 'false')
      })

      items.forEach((item) => {
        const itemCategory = item.getAttribute('data-category')
        const matches = selectedCategory === 'all' || itemCategory === selectedCategory

        if (matches) {
          item.style.display = 'grid'
          if (!isReducedMotion) {
            gsap.fromTo(item, { opacity: 0, y: 15 }, { opacity: 1, y: 0, duration: 0.4, ease: 'power2.out' })
          } else {
            item.style.opacity = '1'
          }
        } else {
          item.style.display = 'none'
          item.style.opacity = '0'
        }
      })

      ScrollTrigger.refresh()
    })
  })
</script>

<style>
  .trajectory-section {
    position: relative;
    padding: 9rem 1.5rem;
    background-color: var(--bg-primary);
    color: var(--text-primary);
    overflow: hidden;
  }

  .trajectory-container {
    max-width: 1360px;
    margin: 0 auto;
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .trajectory-header {
    max-width: 820px;
    margin-bottom: 5rem;
  }

  .section-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
  }

  .section-desc {
    font-family: var(--font-sans);
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 680px;
  }

  .trajectory-layout {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 4.5rem;
    align-items: start;
    position: relative;
  }

  .trajectory-sidebar {
    position: sticky;
    top: calc(var(--header-height, 72px) + 2rem);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .telemetry-panel {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.75rem;
    backdrop-filter: blur(8px);
  }

  .telemetry-panel__header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding-bottom: 1.25rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .telemetry-panel__status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #22c55e;
    box-shadow: 0 0 10px rgba(34, 197, 94, 0.5);
  }

  .telemetry-panel__status-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .telemetry-panel__body {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  .telemetry-metric {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .telemetry-metric__label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .telemetry-metric__value {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .telemetry-metric__sub {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .telemetry-metric__text {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-secondary);
  }

  .telemetry-languages {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: 0.25rem;
  }

  .language-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .language-name {
    color: var(--text-muted);
  }

  .language-level {
    color: var(--text-primary);
  }

  .trajectory-filter {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .filter-heading {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .filter-pills {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .filter-pill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 0.85rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 11px;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: left;
    width: 100%;
  }

  .filter-pill:hover {
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-primary);
    border-color: rgba(255, 255, 255, 0.06);
  }

  .filter-pill.is-active {
    background: rgba(255, 255, 255, 0.07);
    color: var(--text-primary);
    border-color: rgba(255, 255, 255, 0.16);
  }

  .filter-pill__count {
    color: var(--text-muted);
    font-size: 10px;
  }

  .filter-pill.is-active .filter-pill__count {
    color: var(--text-primary);
  }

  .trajectory-stream {
    position: relative;
    padding-left: 2.5rem;
  }

  .timeline-spine {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 8px;
    width: 1px;
    background-color: rgba(255, 255, 255, 0.08);
    pointer-events: none;
  }

  .timeline-spine__progress {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, #ffffff 0%, rgba(255, 255, 255, 0.3) 100%);
    transform: scaleY(0);
    transform-origin: top center;
  }

  .timeline-items {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 1.5rem;
    position: relative;
    align-items: start;
  }

  .timeline-item__anchor {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 28px;
    margin-left: -2.5rem;
    width: 17px;
  }

  .timeline-item__node {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background-color: var(--bg-primary);
    border: 2px solid rgba(255, 255, 255, 0.4);
    transition: all 0.3s ease;
    box-shadow: 0 0 0 4px var(--bg-primary);
  }

  .timeline-item:hover .timeline-item__node {
    border-color: #ffffff;
    box-shadow: 0 0 0 4px var(--bg-primary), 0 0 12px rgba(255, 255, 255, 0.4);
    transform: scale(1.15);
  }

  .timeline-item__card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .timeline-item:hover .timeline-item__card {
    border-color: rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.03);
    transform: translateY(-2px);
  }

  .card-header {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  .card-period {
    color: var(--text-primary);
    font-weight: 500;
  }

  .card-category {
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .card-status {
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
    font-size: 10px;
    text-transform: uppercase;
  }

  .card-role {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2vw, 1.7rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .card-entity {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--text-secondary);
  }

  .entity-name {
    font-family: var(--font-sans);
    font-weight: 500;
    color: var(--text-secondary);
  }

  .entity-sep {
    color: var(--text-muted);
  }

  .entity-loc {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
  }

  .card-summary {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .card-highlights {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .highlights-title {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    text-transform: uppercase;
  }

  .highlights-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .highlights-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .highlight-bullet {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    flex-shrink: 0;
    user-select: none;
    margin-top: 1px;
  }

  .highlight-text {
    color: rgba(255, 255, 255, 0.82);
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .tag-pill {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-secondary);
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    letter-spacing: 0.02em;
  }

  @media (max-width: 1024px) {
    .trajectory-layout {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .trajectory-sidebar {
      position: static;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }

    .filter-pills {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 768px) {
    .trajectory-section {
      padding: 5rem 1rem;
    }

    .trajectory-header {
      margin-bottom: 3.5rem;
    }

    .trajectory-sidebar {
      grid-template-columns: 1fr;
    }

    .filter-pills {
      grid-template-columns: 1fr;
    }

    .trajectory-stream {
      padding-left: 1.75rem;
    }

    .timeline-spine {
      left: 4px;
    }

    .timeline-item__anchor {
      margin-left: -1.75rem;
      width: 9px;
    }

    .timeline-item {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .timeline-item__anchor {
      display: none;
    }

    .timeline-spine {
      display: none;
    }

    .trajectory-stream {
      padding-left: 0;
    }

    .timeline-item__card {
      padding: 1.5rem;
    }
  }
</style>

