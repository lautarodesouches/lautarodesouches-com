<div class="projects-asym-grid" id="grid-cards-container">
  {/* Fila 1: Chichess - B2B Enterprise (Asimétrico 62% / 38%) */}
  <article class="grid-card grid-card--asym-left" data-project-id={chichess.id}>
    <div class="grid-card__visual">
      <div class="grid-browser">
        <div class="grid-browser__bar">
          <div class="grid-dots" aria-hidden="true">
            <span class="grid-dot"></span>
            <span class="grid-dot"></span>
            <span class="grid-dot"></span>
          </div>
          <div class="grid-url">
            <span class="url-protocol">https://</span>
            <span class="url-host">{getHostname(chichess.demoUrl)}</span>
          </div>
        </div>
        <div class="grid-viewport">
          <a
            href={chichess.demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="grid-link"
            aria-label={`Ver demostración de ${chichess.title}`}
          >
            <img
              src={chichess.image}
              alt={`Mockup de ${chichess.title}`}
              class="grid-img"
              loading="eager"
              decoding="async"
            />
            <div class="grid-overlay" aria-hidden="true">
              <span class="grid-overlay-pill">
                <span>Ver Proyecto</span>
                <span class="action-arrow">↗</span>
