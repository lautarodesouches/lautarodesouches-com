<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  let gridTriggers: ScrollTrigger[] = []

  const initGridTriggers = () => {
    gridTriggers.forEach((st) => st.kill())
    gridTriggers = []

    if (isReducedMotion) return

    const cards = gsap.utils.toArray<HTMLElement>('.grid-card')
    cards.forEach((card) => {
      const img = card.querySelector<HTMLElement>('.grid-img')
      if (img) {
        const tween = gsap.fromTo(
          img,
          { yPercent: -6 },
          {
            yPercent: 6,
            ease: 'none',
            paused: true,
          }
        )

        const st = ScrollTrigger.create({
          trigger: card,
          start: 'top bottom',
          end: 'bottom top',
          scrub: true,
          animation: tween,
        })
        gridTriggers.push(st)
      }
    })
  }

  const handleLayoutChange = (e: Event) => {
    const customEvent = e as CustomEvent<{ layout: string }>
    if (customEvent.detail.layout === 'grid') {
      gridTriggers.forEach((st) => st.enable())
      requestAnimationFrame(() => {
        ScrollTrigger.refresh()
      })
    } else {
      gridTriggers.forEach((st) => st.disable(false))
    }
  }

  window.addEventListener('projects:layout-change', handleLayoutChange)

  initGridTriggers()

  const initialLayout =
    new URLSearchParams(window.location.search).get('layout') ||
    sessionStorage.getItem('projects_layout') ||
    'stack'

  if (initialLayout !== 'grid') {
    gridTriggers.forEach((st) => st.disable(false))
  }
</script>

<style>
  .projects-asym-grid {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    width: 100%;
  }

  .grid-card {
    background-color: var(--bg-surface, #121212);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    overflow: hidden;
    transition:
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) and (min-width: 1024px) {
    .grid-card:hover {
      transform: translateY(-4px);
      border-color: rgba(255, 255, 255, 0.22);
      box-shadow: 0 20px 48px -12px rgba(0, 0, 0, 0.7);
    }
  }

  .grid-card--asym-left {
    display: grid;
    grid-template-columns: 62% 38%;
  }

  .grid-card--asym-right {
    display: grid;
    grid-template-columns: 38% 62%;
  }

  .grid-row-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .grid-card--modular {
    display: flex;
    flex-direction: column;
  }

  .grid-card__visual {
    background-color: #0A0A0A;
    padding: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .grid-card--asym-left .grid-card__visual {
    border-right: 1px solid var(--border-subtle);
  }

  .grid-card--asym-right .grid-card__visual {
    border-left: 1px solid var(--border-subtle);
  }

  .grid-card--modular .grid-card__visual {
    border-bottom: 1px solid var(--border-subtle);
    padding: 1.25rem;
  }

  .grid-browser {
    width: 100%;
    background-color: #121212;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.7);
  }

  .grid-browser__bar {
    height: 26px;
    background-color: #161616;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0.85rem;
    gap: 0.75rem;
  }

  .grid-dots {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .grid-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.2);
  }

  .grid-url {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 4px;
    padding: 0.1rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 9px;
    max-width: 220px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .url-protocol {
    color: rgba(255, 255, 255, 0.25);
  }

  .url-host {
    color: rgba(255, 255, 255, 0.6);
  }

  .grid-viewport {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: #0A0A0A;
  }

  .grid-link {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  .grid-img {
    width: 100%;
    height: 112%;
    object-fit: cover;
    object-position: top center;
    display: block;
    will-change: transform;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .grid-browser:hover .grid-img {
    transform: scale(1.02);
  }

  .grid-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(10, 10, 10, 0.45);
    backdrop-filter: blur(2px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .grid-browser:hover .grid-overlay {
    opacity: 1;
  }

  .grid-overlay-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    color: #FFFFFF;
