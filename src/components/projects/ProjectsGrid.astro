---
import { portfolioData } from '../../data/portfolio.data'

const [chichess, gusto, zabala, desouches] = portfolioData.projects

const getHostname = (url: string) => {
  try {
    return new URL(url).hostname
  } catch {
    return 'demo.local'
  }
}
